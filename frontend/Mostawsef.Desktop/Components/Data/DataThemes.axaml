<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Mostawsef.Desktop.Components"
                    xmlns:l="using:Mostawsef.Desktop.Services.Local">

    <!-- Badge -->
    <ControlTheme x:Key="{x:Type ui:Badge}" TargetType="ui:Badge">
        <Setter Property="Background" Value="{DynamicResource BrushNeutralSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushNeutralText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusFull}"
                        Padding="{StaticResource PaddingChip}">
                    <TextBlock Text="{TemplateBinding Text}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimarySubtleText}" />
        </Style>
        <Style Selector="^:success">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}" />
        </Style>
        <Style Selector="^:warning">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}" />
        </Style>
        <Style Selector="^:danger">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}" />
        </Style>
        <Style Selector="^:info">
            <Setter Property="Background" Value="{DynamicResource BrushInfoSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushInfoText}" />
        </Style>
    </ControlTheme>

    <!-- Avatar -->
    <ControlTheme x:Key="{x:Type ui:Avatar}" TargetType="ui:Avatar">
        <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimarySubtleText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="{TemplateBinding Size}"
                        Height="{TemplateBinding Size}"
                        CornerRadius="{TemplateBinding RoundRadius}"
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="{TemplateBinding Initials}"
                                   FontSize="{TemplateBinding InitialsFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{TemplateBinding Source}" Stretch="UniformToFill" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- IsColorful: one tone per name; tone0 keeps the default primary look -->
        <Style Selector="^:tone1">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}" />
        </Style>
        <Style Selector="^:tone2">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}" />
        </Style>
        <Style Selector="^:tone3">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}" />
        </Style>
        <Style Selector="^:tone4">
            <Setter Property="Background" Value="{DynamicResource BrushInfoSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushInfoText}" />
        </Style>
    </ControlTheme>

    <!-- Pagination -->
    <ControlTheme x:Key="{x:Type ui:Pagination}" TargetType="ui:Pagination">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ui:IconButton Classes="ghost sm"
                                   Icon="{StaticResource IconChevronStart}"
                                   Command="{TemplateBinding PreviousCommand}"
                                   ToolTip.Tip="{l:Tr Pagination.Previous}" />
                    <TextBlock Classes="caption muted"
                               Margin="8,0"
                               Text="{TemplateBinding Summary}"
                               VerticalAlignment="Center" />
                    <ui:IconButton Classes="ghost sm"
                                   Icon="{StaticResource IconChevronEnd}"
                                   Command="{TemplateBinding NextCommand}"
                                   ToolTip.Tip="{l:Tr Pagination.Next}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- DataTable -->
    <ControlTheme x:Key="{x:Type ui:DataTable}" TargetType="ui:DataTable">
        <Setter Property="EmptyTitle" Value="{l:Tr Empty.Title}" />
        <Setter Property="EmptyDescription" Value="{l:Tr Empty.Description}" />
        <Setter Property="ErrorTitle" Value="{l:Tr Error.Title}" />
        <Setter Property="ErrorDescription" Value="{l:Tr Error.Description}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="12"
                                BorderBrush="{DynamicResource BrushDivider}"
                                BorderThickness="0,0,0,1"
                                IsVisible="{TemplateBinding Toolbar, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Toolbar}" />
                        </Border>
                        <Border DockPanel.Dock="Bottom"
                                Padding="12,6"
                                BorderBrush="{DynamicResource BrushDivider}"
                                BorderThickness="0,1,0,0"
                                IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Footer}" />
                        </Border>
                        <ui:LoadingOverlay IsLoading="{TemplateBinding IsLoading}">
                            <Panel>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <ui:EmptyState Margin="0,56,0,24"
                                               VerticalAlignment="Top"
                                               Icon="{StaticResource IconInbox}"
                                               Title="{TemplateBinding EmptyTitle}"
                                               Description="{TemplateBinding EmptyDescription}"
                                               IsVisible="{TemplateBinding ShowEmpty}" />
                                <ui:ErrorState Margin="0,56,0,24"
                                               VerticalAlignment="Top"
                                               Title="{TemplateBinding ErrorTitle}"
                                               Description="{TemplateBinding ErrorDescription}"
                                               RetryCommand="{TemplateBinding RetryCommand}"
                                               IsVisible="{TemplateBinding ShowError}" />
                            </Panel>
                        </ui:LoadingOverlay>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- StatCard -->
    <ControlTheme x:Key="{x:Type ui:StatCard}" TargetType="ui:StatCard">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{StaticResource PaddingCard}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="{StaticResource BorderWidth}"
                        CornerRadius="{StaticResource RadiusLg}"
                        BoxShadow="{DynamicResource ShadowSm}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}">
                        <Border Name="PART_IconTile"
                                Width="44"
                                Height="44"
                                CornerRadius="{StaticResource RadiusMd}"
                                Background="{DynamicResource BrushPrimarySubtle}"
                                VerticalAlignment="Top">
                            <PathIcon Name="PART_Icon"
                                      Data="{TemplateBinding Icon}"
                                      Width="{StaticResource IconSize}"
                                      Height="{StaticResource IconSize}"
                                      Foreground="{DynamicResource BrushPrimary}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}" VerticalAlignment="Center">
                            <TextBlock Classes="caption muted" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="h2" Text="{TemplateBinding Value}" />
                            <TextBlock Classes="caption muted"
                                       Text="{TemplateBinding Caption}"
                                       TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Caption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:success /template/ Border#PART_IconTile">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSubtle}" />
        </Style>
        <Style Selector="^:success /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
        </Style>
        <Style Selector="^:warning /template/ Border#PART_IconTile">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
        </Style>
        <Style Selector="^:warning /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
        </Style>
        <Style Selector="^:danger /template/ Border#PART_IconTile">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
        </Style>
        <Style Selector="^:danger /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="^:info /template/ Border#PART_IconTile">
            <Setter Property="Background" Value="{DynamicResource BrushInfoSubtle}" />
        </Style>
        <Style Selector="^:info /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource BrushInfo}" />
        </Style>
    </ControlTheme>

    <!-- DetailsView -->
    <ControlTheme x:Key="{x:Type ui:DetailsView}" TargetType="ui:DetailsView">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource Space3}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:DetailsItem}" TargetType="ui:DetailsItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="150,*" ColumnSpacing="{StaticResource Space4}">
                    <TextBlock Classes="muted" Text="{TemplateBinding Label}" TextWrapping="Wrap" />
                    <SelectableTextBlock Name="PART_Value"
                                         Grid.Column="1"
                                         Text="{TemplateBinding DisplayValue}"
                                         TextWrapping="Wrap" />
                    <Border Name="PART_Code"
                            Grid.Column="1"
                            Padding="{StaticResource PaddingControl}"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="{StaticResource BorderWidth}"
                            CornerRadius="{StaticResource RadiusMd}"
                            IsVisible="False">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{TemplateBinding DisplayValue}"
                                                 FontFamily="{StaticResource FontFamilyMono}"
                                                 FontSize="{StaticResource FontSizeCaption}"
                                                 FlowDirection="LeftToRight" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsCode=True] /template/ SelectableTextBlock#PART_Value">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[IsCode=True] /template/ Border#PART_Code">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
