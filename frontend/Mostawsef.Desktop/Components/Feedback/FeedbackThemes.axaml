<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Mostawsef.Desktop.Components"
                    xmlns:l="using:Mostawsef.Desktop.Services.Local">

    <!-- Spinner -->
    <ControlTheme x:Key="{x:Type ui:Spinner}" TargetType="ui:Spinner">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Ellipse Stroke="{DynamicResource BrushBorder}" StrokeThickness="3" />
                    <Arc Name="PART_Arc"
                         Stroke="{TemplateBinding Foreground}"
                         StrokeThickness="3"
                         StrokeLineCap="Round"
                         StartAngle="0"
                         SweepAngle="90">
                        <Arc.RenderTransform>
                            <RotateTransform />
                        </Arc.RenderTransform>
                    </Arc>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Arc#PART_Arc">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- LoadingOverlay -->
    <ControlTheme x:Key="{x:Type ui:LoadingOverlay}" TargetType="ui:LoadingOverlay">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" />
                    <Panel IsVisible="{TemplateBinding IsLoading}">
                        <Border Background="{DynamicResource BrushSurface}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="{DynamicResource OpacityVeil}" />
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:Spinner HorizontalAlignment="Center" />
                            <TextBlock Classes="muted"
                                       Text="{TemplateBinding Message}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- EmptyState -->
    <ControlTheme x:Key="{x:Type ui:EmptyState}" TargetType="ui:EmptyState">
        <Setter Property="Icon" Value="{StaticResource IconInbox}" />
        <Setter Property="Title" Value="{l:Tr Empty.Title}" />
        <Setter Property="Description" Value="{l:Tr Empty.Description}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="12" MaxWidth="360" HorizontalAlignment="Center">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="28"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            HorizontalAlignment="Center">
                        <PathIcon Data="{TemplateBinding Icon}"
                                  Width="26"
                                  Height="26"
                                  Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>
                    <TextBlock Classes="h4"
                               Text="{TemplateBinding Title}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="muted"
                               Text="{TemplateBinding Description}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ContentPresenter Content="{TemplateBinding Action}"
                                      HorizontalAlignment="Center"
                                      Margin="0,4,0,0"
                                      IsVisible="{TemplateBinding Action, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
