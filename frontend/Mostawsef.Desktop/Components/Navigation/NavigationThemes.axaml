<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Mostawsef.Desktop.Components"
                    xmlns:l="using:Mostawsef.Desktop.Services.Local">

    <!-- Breadcrumb -->
    <ControlTheme x:Key="{x:Type ui:Breadcrumb}" TargetType="ui:Breadcrumb">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:BreadcrumbItem}" TargetType="ui:BreadcrumbItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Background="{TemplateBinding Background}">
                    <!-- U+203A is bidi-mirrored, so it points the right way in RTL -->
                    <TextBlock Name="PART_Separator"
                               Text="›"
                               Margin="8,0"
                               Foreground="{DynamicResource BrushTextDisabled}"
                               VerticalAlignment="Center" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="^:nth-child(1) /template/ TextBlock#PART_Separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:nth-last-child(1)">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- Stepper -->
    <ControlTheme x:Key="{x:Type ui:Stepper}" TargetType="ui:Stepper">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsControl ItemsSource="{TemplateBinding Items}">
                    <ItemsControl.Styles>
                        <Style Selector="Border.step-circle">
                            <Setter Property="Width" Value="28" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="CornerRadius" Value="14" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextMuted}" />
                        </Style>
                        <Style Selector="Border.step-circle.current">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushPrimary}" />
                        </Style>
                        <Style Selector="Border.step-circle.done">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushOnPrimary}" />
                        </Style>
                        <Style Selector="TextBlock.step-title">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                        </Style>
                        <Style Selector="TextBlock.step-title.current">
                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="Border.step-line">
                            <Setter Property="Height" Value="2" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                            <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style Selector="Border.step-line.done">
                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:StepperStep">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Border Classes="step-circle"
                                        Classes.current="{Binding IsCurrent}"
                                        Classes.done="{Binding IsDone}">
                                    <Panel>
                                        <TextBlock Text="{Binding Number}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsDone}" />
                                        <PathIcon Data="{StaticResource IconCheck}"
                                                  Width="14"
                                                  Height="14"
                                                  IsVisible="{Binding IsDone}" />
                                    </Panel>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Classes="step-title"
                                           Classes.current="{Binding IsCurrent}"
                                           Margin="8,0,12,0"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Classes="step-line"
                                        Classes.done="{Binding IsDone}"
                                        IsVisible="{Binding !IsLast}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Wizard -->
    <ControlTheme x:Key="{x:Type ui:Wizard}" TargetType="ui:Wizard">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <ui:Stepper DockPanel.Dock="Top"
                                Margin="0,0,0,24"
                                Steps="{TemplateBinding StepTitles}"
                                CurrentIndex="{TemplateBinding CurrentIndex}" />
                    <Border DockPanel.Dock="Bottom"
                            Margin="0,24,0,0"
                            Padding="0,16,0,0"
                            BorderBrush="{DynamicResource BrushDivider}"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Classes="secondary"
                                    Content="{l:Tr Common.Back}"
                                    Command="{TemplateBinding BackCommand}" />
                            <Panel Grid.Column="2">
                                <Button Classes="primary"
                                        Content="{l:Tr Common.Next}"
                                        Command="{TemplateBinding NextCommand}"
                                        IsVisible="{TemplateBinding IsLastPage, Converter={x:Static BoolConverters.Not}}" />
                                <Button Classes="primary"
                                        Content="{l:Tr Common.Finish}"
                                        Command="{TemplateBinding NextCommand}"
                                        IsVisible="{TemplateBinding IsLastPage}" />
                            </Panel>
                        </Grid>
                    </Border>
                    <ContentPresenter Content="{TemplateBinding CurrentPage}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:WizardPage}" TargetType="ui:WizardPage">
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
