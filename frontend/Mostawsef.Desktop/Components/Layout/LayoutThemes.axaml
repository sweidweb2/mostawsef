<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Mostawsef.Desktop.Components"
                    xmlns:l="using:Mostawsef.Desktop.Services.Local">

    <!-- AppShell -->
    <ControlTheme x:Key="{x:Type ui:AppShell}" TargetType="ui:AppShell">
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <Border Name="PART_Sidebar"
                            Width="{StaticResource SidebarWidth}"
                            Background="{DynamicResource BrushSidebar}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="0,0,1,0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="{StaticResource DurationNormal}" />
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <Grid Name="PART_SidebarTop"
                                  DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto"
                                  Height="{StaticResource TopBarHeight}"
                                  Margin="12,0,8,0">
                                <ContentPresenter Name="PART_SidebarHeader"
                                                  Content="{TemplateBinding SidebarHeader}"
                                                  VerticalAlignment="Center"
                                                  ClipToBounds="True" />
                                <Button Name="PART_Toggle"
                                        Grid.Column="1"
                                        Classes="ghost icon"
                                        Command="{TemplateBinding ToggleSidebarCommand}">
                                    <PathIcon Data="{StaticResource IconMenu}" />
                                </Button>
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Bottom"
                                              Content="{TemplateBinding SidebarFooter}"
                                              Margin="8" />
                            <ContentPresenter Content="{TemplateBinding Sidebar}" Margin="8,4" />
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1">
                        <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding TopBar}" />
                        <Border Name="PART_Content">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}" />
                        </Border>
                    </DockPanel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:compact /template/ Border#PART_Sidebar">
            <Setter Property="Width" Value="{StaticResource SidebarCompactWidth}" />
        </Style>
        <Style Selector="^:compact /template/ ContentPresenter#PART_SidebarHeader">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:compact /template/ Grid#PART_SidebarTop">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:compact /template/ Button#PART_Toggle">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <!-- NavMenu -->
    <ControlTheme x:Key="{x:Type ui:NavMenu}" TargetType="ui:NavMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- NavMenuItem -->
    <ControlTheme x:Key="{x:Type ui:NavMenuItem}" TargetType="ui:NavMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Height="40"
                        Padding="12,0"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusMd}">
                    <Grid Name="PART_Grid" ColumnDefinitions="Auto,*">
                        <PathIcon Data="{TemplateBinding Icon}"
                                  Width="{StaticResource IconSize}"
                                  Height="{StaticResource IconSize}"
                                  Foreground="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center" />
                        <TextBlock Name="PART_Text"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSidebarItemHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource BrushSidebarItemActive}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSidebarItemActiveText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Text">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[IsCompact=True] /template/ Border#PART_Root">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^[IsCompact=True] /template/ Grid#PART_Grid">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <!-- TopBar -->
    <ControlTheme x:Key="{x:Type ui:TopBar}" TargetType="ui:TopBar">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="{StaticResource TopBarHeight}"
                        Padding="16,0"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <ContentPresenter Content="{TemplateBinding Leading}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Classes="h4"
                                   Margin="4,0,16,0"
                                   Text="{TemplateBinding Title}"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="3"
                                          Margin="16,0,0,0"
                                          Content="{TemplateBinding Actions}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- BrandMark: sizes are set by styles (not in the template) so the lg class can override them. -->
    <ControlTheme x:Key="{x:Type ui:BrandMark}" TargetType="ui:BrandMark">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Name="PART_Root">
                    <Border Name="PART_Tile" Background="{DynamicResource BrushPrimary}" HorizontalAlignment="Center">
                        <PathIcon Name="PART_Icon" Data="{StaticResource IconMedical}" Foreground="{DynamicResource BrushOnPrimary}" />
                    </Border>
                    <TextBlock Name="PART_Title"
                               Text="{l:Tr App.Title}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ StackPanel#PART_Root">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="{StaticResource GapControls}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Tile">
            <Setter Property="Width" Value="{StaticResource BrandMarkSize}" />
            <Setter Property="Height" Value="{StaticResource BrandMarkSize}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        </Style>
        <Style Selector="^ /template/ PathIcon#PART_Icon">
            <Setter Property="Width" Value="{StaticResource IconSize}" />
            <Setter Property="Height" Value="{StaticResource IconSize}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Title">
            <Setter Property="FontSize" Value="{StaticResource FontSizeH4}" />
            <Setter Property="LineHeight" Value="{StaticResource LineHeightH4}" />
        </Style>

        <Style Selector="^.lg /template/ StackPanel#PART_Root">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Spacing" Value="{StaticResource GapStack}" />
        </Style>
        <Style Selector="^.lg /template/ Border#PART_Tile">
            <Setter Property="Width" Value="{StaticResource BrandMarkSizeLg}" />
            <Setter Property="Height" Value="{StaticResource BrandMarkSizeLg}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        </Style>
        <Style Selector="^.lg /template/ PathIcon#PART_Icon">
            <Setter Property="Width" Value="{StaticResource IconSizeLg}" />
            <Setter Property="Height" Value="{StaticResource IconSizeLg}" />
        </Style>
        <Style Selector="^.lg /template/ TextBlock#PART_Title">
            <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
            <Setter Property="LineHeight" Value="{StaticResource LineHeightH2}" />
        </Style>
    </ControlTheme>

    <!-- PreferencesBar -->
    <ControlTheme x:Key="{x:Type ui:PreferencesBar}" TargetType="ui:PreferencesBar">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                    <ui:IconButton Name="PART_Theme"
                                   Classes="ghost"
                                   Icon="{StaticResource IconTheme}"
                                   Command="{TemplateBinding ToggleThemeCommand}"
                                   ToolTip.Tip="{l:Tr Theme.Toggle}" />
                    <Button Name="PART_Language"
                            Classes="secondary"
                            Command="{TemplateBinding ToggleLanguageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconGlobe}" />
                            <TextBlock Text="{l:Tr Language.Switch}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- PageHeader -->
    <ControlTheme x:Key="{x:Type ui:PageHeader}" TargetType="ui:PageHeader">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="8">
                    <ContentPresenter Content="{TemplateBinding Breadcrumb}"
                                      IsVisible="{TemplateBinding Breadcrumb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid Name="PART_Grid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted"
                                       Text="{TemplateBinding Subtitle}"
                                       TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ContentPresenter Name="PART_Actions"
                                          Grid.Column="1"
                                          Margin="16,0,0,0"
                                          Content="{TemplateBinding Actions}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Card -->
    <ControlTheme x:Key="{x:Type ui:Card}" TargetType="ui:Card">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource ShadowSm}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              ColumnDefinitions="*,Auto"
                              Margin="20,16,20,0"
                              IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="h4" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                                <TextBlock Classes="caption muted"
                                           Text="{TemplateBinding Subtitle}"
                                           TextWrapping="Wrap"
                                           IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderActions}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <Border DockPanel.Dock="Bottom"
                                Padding="20,12"
                                BorderBrush="{DynamicResource BrushDivider}"
                                BorderThickness="0,1,0,0"
                                IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Footer}" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.outlined /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowNone}" />
        </Style>
        <Style Selector="^.flat">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        </Style>
        <Style Selector="^.flat /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowNone}" />
        </Style>
        <Style Selector="^.interactive">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^.interactive:pointerover /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
        </Style>
    </ControlTheme>

    <!-- Divider -->
    <ControlTheme x:Key="{x:Type ui:Divider}" TargetType="ui:Divider">
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto,*">
                    <Border Height="1" Background="{DynamicResource BrushDivider}" VerticalAlignment="Center" />
                    <TextBlock Name="PART_Text"
                               Grid.Column="1"
                               Margin="12,0"
                               Classes="caption muted"
                               Text="{TemplateBinding Text}"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Grid.Column="2" Height="1" Background="{DynamicResource BrushDivider}" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="1" Background="{DynamicResource BrushDivider}" HorizontalAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
