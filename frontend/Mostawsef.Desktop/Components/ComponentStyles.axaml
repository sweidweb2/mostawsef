<!-- Styles for visuals that components create in code (no TemplatedParent, so they can't use /template/ selectors). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DialogHost -->
    <Style Selector="Border.dialog-scrim">
        <Setter Property="Background" Value="{DynamicResource BrushOverlay}" />
    </Style>

    <!-- Scheduler grid -->
    <Style Selector="Border.scheduler-hour-label">
        <Setter Property="Padding" Value="6,2,8,0" />
    </Style>
    <Style Selector="Border.scheduler-hour-label > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.scheduler-slot">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1,0,0,1" />
    </Style>
    <Style Selector="Border.scheduler-day-header">
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.scheduler-day-header.today TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    </Style>
    <Style Selector="Panel.scheduler-day.today">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
    </Style>

    <!-- Scheduler entries -->
    <Style Selector="Border.scheduler-item">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushPrimarySubtleText}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
    <Style Selector="Border.scheduler-item:pointerover">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.scheduler-item.selected">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="Border.scheduler-item.neutral">
        <Setter Property="Background" Value="{DynamicResource BrushNeutralSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushNeutralText}" />
    </Style>
    <Style Selector="Border.scheduler-item.success">
        <Setter Property="Background" Value="{DynamicResource BrushSuccessSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushSuccessText}" />
    </Style>
    <Style Selector="Border.scheduler-item.warning">
        <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushWarningText}" />
    </Style>
    <Style Selector="Border.scheduler-item.danger">
        <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushDangerText}" />
    </Style>
    <Style Selector="Border.scheduler-item.info">
        <Setter Property="Background" Value="{DynamicResource BrushInfoSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushInfo}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushInfoText}" />
    </Style>
</Styles>
