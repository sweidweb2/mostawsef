<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Mostawsef.Desktop.Components"
                    xmlns:l="using:Mostawsef.Desktop.Services.Local">

    <!-- FormField -->
    <ControlTheme x:Key="{x:Type ui:FormField}" TargetType="ui:FormField">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" />
                        <TextBlock Text="*"
                                   Foreground="{DynamicResource BrushDanger}"
                                   IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    <TextBlock Name="PART_Hint"
                               Classes="caption muted"
                               Text="{TemplateBinding Hint}"
                               TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="PART_Error"
                               Classes="caption danger"
                               Text="{TemplateBinding Error}"
                               TextWrapping="Wrap"
                               IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:error /template/ TextBlock#PART_Hint">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:error /template/ TextBlock#PART_Error">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- FormSection -->
    <ControlTheme x:Key="{x:Type ui:FormSection}" TargetType="ui:FormSection">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <ui:ResponsiveGrid MinColumnWidth="260" MaxColumns="{Binding $parent[ui:FormSection].MaxColumns}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2"
                                IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="h4" Text="{TemplateBinding Title}" />
                        <TextBlock Classes="muted"
                                   Text="{TemplateBinding Description}"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ValidationSummary -->
    <ControlTheme x:Key="{x:Type ui:ValidationSummary}" TargetType="ui:ValidationSummary">
        <Setter Property="Title" Value="{l:Tr Validation.Title}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource BrushDangerSubtle}"
                        BorderBrush="{DynamicResource BrushDanger}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Padding="12">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconError}"
                                      Width="16"
                                      Height="16"
                                      Foreground="{DynamicResource BrushDanger}" />
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushDangerText}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{TemplateBinding Errors}" Margin="24,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding StringFormat='• {0}'}"
                                               Foreground="{DynamicResource BrushDangerText}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- DateRangePicker -->
    <ControlTheme x:Key="{x:Type ui:DateRangePicker}" TargetType="ui:DateRangePicker">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption muted" Text="{l:Tr DateRange.From}" />
                        <CalendarDatePicker SelectedDate="{TemplateBinding From, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="caption muted" Text="{l:Tr DateRange.To}" />
                        <CalendarDatePicker SelectedDate="{TemplateBinding To, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- FileUpload -->
    <ControlTheme x:Key="{x:Type ui:FileUpload}" TargetType="ui:FileUpload">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource BrushSurfaceAlt}"
                        BorderBrush="{DynamicResource BrushBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <PathIcon Data="{StaticResource IconUpload}"
                                  Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource BrushTextMuted}" />
                        <Panel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Name="PART_Empty" Classes="muted" Text="{l:Tr FileUpload.NoFile}" />
                            <TextBlock Name="PART_Name"
                                       Text="{TemplateBinding FileName}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="False" />
                        </Panel>
                        <Button Grid.Column="2"
                                Classes="secondary sm"
                                Content="{l:Tr Common.Browse}"
                                Command="{TemplateBinding BrowseCommand}" />
                        <Button Name="PART_Clear"
                                Grid.Column="3"
                                Margin="4,0,0,0"
                                Classes="ghost icon sm"
                                Command="{TemplateBinding ClearCommand}"
                                IsVisible="False">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:has-file /template/ TextBlock#PART_Empty">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-file /template/ TextBlock#PART_Name">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-file /template/ Button#PART_Clear">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- ImagePicker -->
    <ControlTheme x:Key="{x:Type ui:ImagePicker}" TargetType="ui:ImagePicker">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="8">
                    <Border Width="160"
                            Height="160"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            BorderBrush="{DynamicResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLg}"
                            ClipToBounds="True">
                        <Panel>
                            <PathIcon Name="PART_Placeholder"
                                      Data="{StaticResource IconImage}"
                                      Width="40"
                                      Height="40"
                                      Foreground="{DynamicResource BrushTextDisabled}" />
                            <Image Source="{TemplateBinding Preview}" Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary sm"
                                Content="{l:Tr Common.Browse}"
                                Command="{TemplateBinding BrowseCommand}" />
                        <Button Name="PART_Clear"
                                Classes="ghost sm"
                                Content="{l:Tr Common.Remove}"
                                Command="{TemplateBinding ClearCommand}"
                                IsVisible="False" />
                    </StackPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:has-file /template/ PathIcon#PART_Placeholder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-file /template/ Button#PART_Clear">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
