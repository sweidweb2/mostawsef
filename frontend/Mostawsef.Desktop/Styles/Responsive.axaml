<!--
    RESPONSIVENESS ENGINE

    Rules react to the width of the AppShell content area, so they work the same whether the sidebar is expanded
    or collapsed. AppShell sets :narrow while that area is below 900 (AppShell.NarrowContentWidth = BreakpointMedium).

    Utility classes
      .page           page root: padding 24, or 16 when narrow; content capped at ContentMaxWidth
      .hide-compact   hidden while narrow
      .stack-compact  horizontal StackPanel becomes vertical while narrow

    Do NOT use ContainerQuery here: Avalonia re-evaluates container queries for every control added to or removed
    from the container, which made the whole app 20-60x slower on any UI change (e.g. 2 s to switch the New Order
    patient mode). Add a pseudo-class on AppShell instead, like :narrow.

    Layout helpers (code): ResponsiveGrid (auto columns), AppShell (sidebar collapses below AutoCompactWidth).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Mostawsef.Desktop.Components">

    <!-- Page root -->
    <Style Selector=":is(Control).page">
        <Setter Property="Margin" Value="{StaticResource PaddingPage}" />
        <Setter Property="MaxWidth" Value="{StaticResource ContentMaxWidth}" />
    </Style>

    <!-- Narrow: content area < 900 -->
    <Style Selector="ui|AppShell:narrow :is(Control).page">
        <Setter Property="Margin" Value="{StaticResource PaddingPageCompact}" />
    </Style>
    <Style Selector="ui|AppShell:narrow :is(Control).hide-compact">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ui|AppShell:narrow StackPanel.stack-compact">
        <Setter Property="Orientation" Value="Vertical" />
    </Style>

    <!-- Page header actions wrap under the title -->
    <Style Selector="ui|AppShell:narrow ui|PageHeader /template/ ContentPresenter#PART_Actions">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
</Styles>
