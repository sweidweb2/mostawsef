<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 4px spacing scale -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space10">40</x:Double>

    <Thickness x:Key="PaddingControl">12,6</Thickness>
    <Thickness x:Key="PaddingControlSm">8,4</Thickness>
    <Thickness x:Key="PaddingControlLg">16,10</Thickness>
    <Thickness x:Key="PaddingCard">20</Thickness>
    <Thickness x:Key="PaddingPage">24</Thickness>
    <Thickness x:Key="PaddingDialog">24</Thickness>

    <!-- Control sizes -->
    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightSm">28</x:Double>
    <x:Double x:Key="ControlHeightLg">44</x:Double>
    <x:Double x:Key="IconSize">18</x:Double>
    <x:Double x:Key="IconSizeSm">14</x:Double>
    <x:Double x:Key="IconSizeLg">24</x:Double>

    <!-- Shell -->
    <x:Double x:Key="SidebarWidth">240</x:Double>
    <x:Double x:Key="SidebarCompactWidth">64</x:Double>
    <x:Double x:Key="TopBarHeight">56</x:Double>
    <x:Double x:Key="DrawerWidth">420</x:Double>
    <x:Double x:Key="DialogMaxWidth">560</x:Double>
</ResourceDictionary>
