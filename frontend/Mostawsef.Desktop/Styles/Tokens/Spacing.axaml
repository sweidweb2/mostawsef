<!--
    SPACING TOKENS (4 px grid)

    Scale: 0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64
    Rules
      - Margins, paddings and gaps use these values only.
      - Inside a component: 4-12. Between components: 16-24. Between page sections: 32-48.
      - Thickness tokens below are composed for common cases; Avalonia mirrors left/right automatically in RTL.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Scale -->
    <x:Double x:Key="Space0">0</x:Double>
    <x:Double x:Key="SpaceHalf">2</x:Double>
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space10">40</x:Double>
    <x:Double x:Key="Space12">48</x:Double>
    <x:Double x:Key="Space16">64</x:Double>

    <!-- Gaps (StackPanel Spacing, grid gutters) -->
    <x:Double x:Key="GapTight">4</x:Double>
    <x:Double x:Key="GapControls">8</x:Double>
    <x:Double x:Key="GapStack">12</x:Double>
    <x:Double x:Key="GapGrid">16</x:Double>
    <x:Double x:Key="GapSection">32</x:Double>

    <!-- Paddings -->
    <Thickness x:Key="PaddingControlSm">8,4</Thickness>
    <Thickness x:Key="PaddingControl">12,6</Thickness>
    <Thickness x:Key="PaddingControlLg">16,10</Thickness>
    <Thickness x:Key="PaddingInput">10,6</Thickness>
    <Thickness x:Key="PaddingChip">10,2</Thickness>
    <Thickness x:Key="PaddingCard">20</Thickness>
    <Thickness x:Key="PaddingCardCompact">12</Thickness>
    <Thickness x:Key="PaddingDialog">24</Thickness>
    <Thickness x:Key="PaddingPage">24</Thickness>
    <Thickness x:Key="PaddingPageCompact">16</Thickness>
</ResourceDictionary>
