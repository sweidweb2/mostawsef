<!-- Elevation utility classes for any Border: Classes="shadow-md". Values live in ShadowTokens.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.shadow-sm">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}" />
    </Style>
    <Style Selector="Border.shadow-md">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
    </Style>
    <Style Selector="Border.shadow-lg">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
</Styles>
