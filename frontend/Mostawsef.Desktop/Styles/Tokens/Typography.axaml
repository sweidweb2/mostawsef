<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Covers both Arabic and Latin glyphs -->
    <FontFamily x:Key="FontFamilyBase">avares://Mostawsef.Desktop/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>

    <!-- Fluent overrides so built-in controls use the same font -->
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://Mostawsef.Desktop/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>
    <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>

    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="FontSizeH4">18</x:Double>
    <x:Double x:Key="FontSizeH3">20</x:Double>
    <x:Double x:Key="FontSizeH2">24</x:Double>
    <x:Double x:Key="FontSizeH1">30</x:Double>
    <x:Double x:Key="FontSizeDisplay">36</x:Double>

    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
</ResourceDictionary>
