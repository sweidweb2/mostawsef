<!--
    Breakpoints (width of the AppShell content area, not the window).
    Keep in sync with Mostawsef.Desktop.Components.Breakpoints and the queries in Styles/Responsive.axaml.
      Compact: < 900
      Medium:  900 - 1279
      Wide:    >= 1280
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="BreakpointMedium">900</x:Double>
    <x:Double x:Key="BreakpointWide">1280</x:Double>
</ResourceDictionary>
