<!-- Tabs, menus, flyouts, tooltips, split view. Flyout popover: <Flyout FlyoutPresenterClasses="popover"> -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tabs -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
    </Style>

    <!-- Menus -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>

    <!-- Popover -->
    <Style Selector="FlyoutPresenter.popover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <!-- Tooltip -->
    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!-- Split view -->
    <Style Selector="SplitView">
        <Setter Property="PaneBackground" Value="{DynamicResource BrushSurface}" />
    </Style>
</Styles>
