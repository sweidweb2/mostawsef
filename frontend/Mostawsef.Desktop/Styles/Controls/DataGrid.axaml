<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Mostawsef.Desktop.Components">

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="{StaticResource TableRowHeight}" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{StaticResource TableHeaderHeight}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--
        Row hover: a light tint and an accent bar on the start edge (left in English, right in Arabic).
        The bar is always there but transparent, so hovering never shifts the cells.
    -->
    <Style Selector="DataGridRow">
        <Setter Property="BorderThickness" Value="{StaticResource TableRowAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{StaticResource DurationFast}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="{StaticResource DurationFast}" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Orders that are not fully paid yet (see OrdersView.OnLoadingRow). -->
    <Style Selector="DataGridRow.unpaid /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource BrushWarningSubtle}" />
    </Style>
    <!-- Orders paid beyond their total: a refund is due (see OrdersView.OnLoadingRow). -->
    <Style Selector="DataGridRow.refund /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource BrushInfoSubtle}" />
    </Style>
    <!-- A patient card with an order not paid in full (see PatientsView). -->
    <Style Selector="ui|Card.unpaid">
        <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
    </Style>
    <Style Selector="DataGrid.clickable-rows DataGridRow">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource BrushPrimarySubtle}" />
    </Style>
</Styles>
