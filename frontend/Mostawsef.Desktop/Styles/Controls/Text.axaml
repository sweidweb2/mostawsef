<!--
    Typography classes: <TextBlock Classes="h2" />, <TextBlock Classes="caption muted" />
    Sizes:   display, h1, h2, h3, h4, body-lg, body, caption (each with its paired line height)
    Colors:  muted, primary, link, success, warning, danger
    Weight:  strong
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector=":is(Window)">
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- Sizes -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightH1}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightH2}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightH3}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    </Style>
    <Style Selector="TextBlock.h4">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH4}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightH4}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    </Style>
    <Style Selector="TextBlock.body-lg">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBodyLarge}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
    </Style>

    <!-- Colors -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
    </Style>
    <Style Selector="TextBlock.primary">
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    </Style>
    <Style Selector="TextBlock.link">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextLink}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>

    <!-- Weight -->
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    </Style>
</Styles>
