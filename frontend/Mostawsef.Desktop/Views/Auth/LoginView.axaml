<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Auth"
             x:Class="Mostawsef.Desktop.Views.Auth.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BrushBackground}">

    <Grid RowDefinitions="Auto,*">
        <ui:PreferencesBar HorizontalAlignment="Right" Margin="{StaticResource PaddingPage}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ui:Card Width="420"
                     MaxWidth="420"
                     Margin="{StaticResource PaddingPageCompact}"
                     Padding="32"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <StackPanel Spacing="{StaticResource Space6}">
                    <!-- Brand -->
                    <StackPanel Spacing="{StaticResource Space3}" HorizontalAlignment="Center">
                        <ui:BrandMark Classes="lg" HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{l:Tr Login.Subtitle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Form -->
                    <StackPanel Spacing="{StaticResource GapGrid}">
                        <ui:FormField Label="{l:Tr Login.Username}" IsRequired="True">
                            <TextBox Name="UsernameBox"
                                     Text="{Binding Username}"
                                     PlaceholderText="{l:Tr Login.UsernamePlaceholder}" />
                        </ui:FormField>
                        <ui:FormField Label="{l:Tr Login.Password}" IsRequired="True">
                            <ui:PasswordField Name="PasswordBox"
                                              Text="{Binding Password}"
                                              PlaceholderText="{l:Tr Login.PasswordPlaceholder}" />
                        </ui:FormField>

                        <Border Background="{DynamicResource BrushDangerSubtle}"
                                BorderBrush="{DynamicResource BrushDangerBorder}"
                                BorderThickness="{StaticResource BorderWidth}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="{StaticResource PaddingControl}"
                                IsVisible="{Binding HasError}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconError}"
                                          Width="{StaticResource IconSizeSm}"
                                          Height="{StaticResource IconSizeSm}"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Top"
                                          Foreground="{DynamicResource BrushDanger}" />
                                <TextBlock Grid.Column="1"
                                           Text="{l:TrKey {Binding ErrorKey}}"
                                           Foreground="{DynamicResource BrushDangerText}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Button Classes="primary lg"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsDefault="True"
                                Command="{Binding LoginCommand}">
                            <Panel>
                                <TextBlock Text="{l:Tr Login.Submit}" IsVisible="{Binding !IsBusy}" />
                                <ui:Spinner Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource BrushOnPrimary}"
                                            IsVisible="{Binding IsBusy}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <Button Classes="link"
                            HorizontalAlignment="Center"
                            Content="{l:Tr Login.OpenGallery}"
                            Command="{Binding OpenGalleryCommand}"
                            IsVisible="{Binding IsDevBuild}" />
                </StackPanel>
            </ui:Card>
        </ScrollViewer>
    </Grid>
</UserControl>
