<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Auth"
             x:Class="Mostawsef.Desktop.Views.Auth.ChangePasswordFormView"
             x:DataType="vm:ChangePasswordFormViewModel">
    <StackPanel Spacing="{StaticResource GapGrid}">
        <ui:Alert Kind="Danger" Text="{l:TrKey {Binding FormErrorKey}}" />

        <ui:FormField Label="{l:Tr Users.Field.CurrentPassword}" IsRequired="True" Error="{l:FieldError CurrentPassword}">
            <ui:PasswordField Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" />
        </ui:FormField>

        <ui:FormField Label="{l:Tr Users.Field.NewPassword}" IsRequired="True" Error="{l:FieldError NewPassword}">
            <ui:PasswordField Name="NewPasswordBox" Text="{Binding NewPassword}" />
        </ui:FormField>

        <ui:FormField Label="{l:Tr Users.Field.ConfirmPassword}" IsRequired="True" Error="{l:FieldError ConfirmPassword}">
            <ui:PasswordField Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" />
        </ui:FormField>
    </StackPanel>
</UserControl>
