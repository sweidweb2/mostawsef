<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Super"
             x:Class="Mostawsef.Desktop.Views.Super.SystemSettingsView"
             x:DataType="vm:SystemSettingsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.SystemSettings}" Subtitle="{l:Tr SystemSettings.Subtitle}">
                <ui:PageHeader.Actions>
                    <Button Name="EditSettingsButton" Classes="primary" Command="{Binding EditCommand}" IsEnabled="{Binding HasSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconEdit}" />
                            <TextBlock Text="{l:Tr Common.Edit}" />
                        </StackPanel>
                    </Button>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:Alert Kind="Warning" Text="{l:TrKey {Binding MaintenanceNoticeKey}}" />

            <ui:Card>
                <ui:LoadingOverlay IsLoading="{Binding IsLoading}">
                    <Panel>
                        <ui:DetailsView IsVisible="{Binding HasSettings}">
                            <ui:DetailsItem Label="{l:Tr SystemSettings.Field.BackupPath}" Value="{Binding Settings.BackupPath, FallbackValue=''}" />
                            <ui:DetailsItem Label="{l:Tr SystemSettings.Field.MaintenanceMode}" Value="{l:TrKey {Binding MaintenanceModeKey}}" />
                            <ui:DetailsItem Label="{l:Tr Settings.Field.UpdatedBy}" Value="{Binding Settings.UpdatedBy, FallbackValue=''}" />
                        </ui:DetailsView>
                        <ui:ErrorState Margin="0,24"
                                       RetryCommand="{Binding RefreshCommand}"
                                       IsVisible="{Binding HasLoadError}" />
                    </Panel>
                </ui:LoadingOverlay>
            </ui:Card>

            <!-- Danger zone: wipe all data except the user accounts. -->
            <ui:Card Name="DangerZone" Title="{l:Tr SystemSettings.DangerZone}"
                     BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapGrid}">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="strong" Text="{l:Tr SystemSettings.ResetTitle}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr SystemSettings.ResetDescription}" />
                    </StackPanel>
                    <Button Name="ResetDataButton" Grid.Column="1" Classes="danger" VerticalAlignment="Center"
                            Command="{Binding ResetDataCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconDelete}" />
                            <TextBlock Text="{l:Tr SystemSettings.ResetButton}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
