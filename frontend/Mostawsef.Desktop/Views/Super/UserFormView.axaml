<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Super"
             x:Class="Mostawsef.Desktop.Views.Super.UserFormView"
             x:DataType="vm:UserFormViewModel">
    <StackPanel Spacing="{StaticResource GapGrid}">
        <ui:Alert Kind="Danger" Text="{l:TrKey {Binding FormErrorKey}}" />

        <ui:FormField Label="{l:Tr Users.Col.FullName}" IsRequired="True" Error="{l:FieldError {Binding Errors[FullName]}}">
            <TextBox Name="FullNameBox" Text="{Binding FullName}" />
        </ui:FormField>

        <ui:FormField Label="{l:Tr Users.Col.Username}"
                      IsRequired="True"
                      Hint="{l:Tr Users.Field.UsernameHint}"
                      Error="{l:FieldError {Binding Errors[Username]}}"
                      IsVisible="{Binding IsNew}">
            <TextBox Name="UsernameBox" Text="{Binding Username}" />
        </ui:FormField>
        <ui:FormField Label="{l:Tr Users.Col.Username}" IsVisible="{Binding !IsNew}">
            <TextBlock Classes="muted" Text="{Binding Username}" />
        </ui:FormField>

        <ui:FormField Label="{l:Tr Users.Field.Password}" IsRequired="True" Error="{l:FieldError {Binding Errors[Password]}}" IsVisible="{Binding IsNew}">
            <ui:PasswordField Name="PasswordBox" Text="{Binding Password}" />
        </ui:FormField>

        <ui:FormField Label="{l:Tr Users.Col.Role}" IsRequired="True" Error="{l:FieldError {Binding Errors[Role]}}">
            <ComboBox Name="RoleBox" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding Role}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{l:TrKey {Binding}, Prefix=Role.}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:FormField>

        <CheckBox Name="IsActiveBox" Content="{l:Tr Users.Field.IsActive}" IsChecked="{Binding IsActive}" IsVisible="{Binding !IsNew}" />
    </StackPanel>
</UserControl>
