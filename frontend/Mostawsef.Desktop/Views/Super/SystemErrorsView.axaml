<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:logs="using:Mostawsef.Contracts.Logs"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Super"
             xmlns:shell="using:Mostawsef.Desktop.ViewModels.Shell"
             x:Class="Mostawsef.Desktop.Views.Super.SystemErrorsView"
             x:DataType="vm:SystemErrorsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.SystemErrors}" Subtitle="{l:Tr Logs.ErrorsSubtitle}">
                <ui:PageHeader.Actions>
                    <Button Classes="secondary" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="{l:Tr Common.Refresh}" />
                        </StackPanel>
                    </Button>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <!-- Stats -->
            <ui:ResponsiveGrid MinColumnWidth="220" Margin="0,0,0,24">
                <ui:StatCard Title="{l:Tr Logs.Stat.TotalErrors}" Value="{Binding Stats.Total, FallbackValue='—'}"
                             Icon="{StaticResource IconError}" Kind="Warning" />
                <ui:StatCard Title="{l:Tr Logs.Stat.Today}" Value="{Binding Stats.Today, FallbackValue='—'}"
                             Icon="{StaticResource IconClock}" Kind="Info" />
                <ui:StatCard Title="{l:Tr Logs.Stat.Last7Days}" Value="{Binding Stats.Last7Days, FallbackValue='—'}"
                             Icon="{StaticResource IconCalendar}" Kind="Primary" />
                <ui:StatCard Title="{l:Tr Logs.Stat.Critical}" Value="{Binding Stats.Critical, FallbackValue='—'}"
                             Icon="{StaticResource IconWarning}" Kind="Danger" />
            </ui:ResponsiveGrid>

            <!-- Table -->
            <ui:DataTable Height="560"
                          IsLoading="{Binding IsLoading}"
                          IsEmpty="{Binding IsEmpty}"
                          HasError="{Binding HasLoadError}"
                          ErrorTitle="{l:TrKey {Binding LoadErrorTitleKey}}"
                          ErrorDescription="{l:TrKey {Binding LoadErrorDescriptionKey}}"
                          RetryCommand="{Binding RefreshCommand}"
                          FirstRowNumber="{Binding FirstRowNumber}">
                <ui:DataTable.Toolbar>
                    <StackPanel Spacing="{StaticResource GapControls}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource GapGrid}">
                            <ui:SearchBox MaxWidth="360"
                                          HorizontalAlignment="Left"
                                          Text="{Binding Search}"
                                          SearchCommand="{Binding SearchCommand}" />
                            <TextBlock Grid.Column="1" Classes="caption muted" Text="{l:Tr Logs.Records, Arg={Binding TotalCount}}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <Button Name="SelectModeButton" Classes="secondary" Command="{Binding ToggleSelectModeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                        <PathIcon Data="{StaticResource IconCheck}" />
                                        <TextBlock Text="{l:TrKey {Binding SelectModeKey}}" />
                                    </StackPanel>
                                </Button>
                                <Button Name="DeleteAllButton" Classes="danger" Command="{Binding DeleteAllCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                        <PathIcon Data="{StaticResource IconDelete}" />
                                        <TextBlock Text="{l:Tr Logs.DeleteAll}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Select mode: select the shown page, the count, and delete the selection. -->
                        <Border Name="SelectionBar" IsVisible="{Binding Selection.IsActive}"
                                Background="{DynamicResource BrushPrimarySubtle}" CornerRadius="8" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapGrid}">
                                <CheckBox Name="SelectPageBox" IsChecked="{Binding IsPageSelected}" Content="{l:Tr Logs.SelectPage}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="strong"
                                           Text="{l:Tr Logs.SelectedCount, Arg={Binding Selection.Count}}" />
                                <Button Name="DeleteSelectedButton" Grid.Column="2" Classes="danger" Command="{Binding DeleteSelectedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                        <PathIcon Data="{StaticResource IconDelete}" />
                                        <TextBlock Text="{l:Tr Logs.DeleteSelected}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:DataTable.Toolbar>

                <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="False" ui:SelectionColumn.IsEnabled="True">
                    <DataGrid.Columns>
                        <!-- Row checkboxes: shown only in select mode (ui:SelectionColumn). Keep it the first column. -->
                        <DataGridTemplateColumn Width="48" IsVisible="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <CheckBox Classes="row-select" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Command="{Binding $parent[DataGrid].((vm:SystemErrorsViewModel)DataContext).ToggleRowCommand}"
                                              CommandParameter="{Binding}">
                                        <CheckBox.IsChecked>
                                            <MultiBinding Converter="{x:Static shell:RowSelection.IsSelectedConverter}" Mode="OneWay">
                                                <Binding Path="$parent[DataGrid].((vm:SystemErrorsViewModel)DataContext).Selection" />
                                                <Binding Path="$parent[DataGrid].((vm:SystemErrorsViewModel)DataContext).Selection.Version" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </CheckBox.IsChecked>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:DataType="logs:SystemErrorListItemDto" Header="{l:Tr Logs.Col.Time}" Width="150"
                                           Binding="{Binding OccurredAt, Converter={x:Static conv:ValueConverters.LocalDateTime}}"
                                           IsReadOnly="True" />
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Level}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <ui:Badge Margin="12,0"
                                              Text="{l:TrKey {Binding Level}, Prefix=ErrorLevel.}"
                                              Kind="{Binding Level, Converter={x:Static conv:ValueConverters.ErrorLevelToBadgeKind}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Source}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding Source}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Message}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Message, Converter={x:Static conv:ValueConverters.Truncate}, ConverterParameter=80}"
                                               ToolTip.Tip="{Binding Message}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Path}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center" Classes="muted"
                                               Text="{Binding RequestPath, Converter={x:Static conv:ValueConverters.Truncate}, ConverterParameter=26}"
                                               ToolTip.Tip="{Binding RequestPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:SystemErrorListItemDto">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="8,0" VerticalAlignment="Center">
                                        <ui:IconButton Classes="ghost sm"
                                                       Icon="{StaticResource IconEye}"
                                                       ToolTip.Tip="{l:Tr Common.View}"
                                                       Command="{Binding $parent[DataGrid].((vm:SystemErrorsViewModel)DataContext).ViewDetailsCommand}"
                                                       CommandParameter="{Binding}" />
                                        <ui:IconButton Classes="ghost destructive sm"
                                                       Icon="{StaticResource IconDelete}"
                                                       ToolTip.Tip="{l:Tr Common.Delete}"
                                                       Command="{Binding $parent[DataGrid].((vm:SystemErrorsViewModel)DataContext).DeleteCommand}"
                                                       CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ui:DataTable.Footer>
                    <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="{Binding PageCount}" IsEnabled="{Binding !IsLoading}" />
                </ui:DataTable.Footer>
            </ui:DataTable>
        </StackPanel>
    </ScrollViewer>
</UserControl>
