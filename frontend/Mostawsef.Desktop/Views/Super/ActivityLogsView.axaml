<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:logs="using:Mostawsef.Contracts.Logs"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Super"
             x:Class="Mostawsef.Desktop.Views.Super.ActivityLogsView"
             x:DataType="vm:ActivityLogsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.ActivityLogs}" Subtitle="{l:Tr Logs.ActivitySubtitle}">
                <ui:PageHeader.Actions>
                    <Button Classes="secondary" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource GapControls}">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="{l:Tr Common.Refresh}" />
                        </StackPanel>
                    </Button>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <!-- Stats -->
            <ui:ResponsiveGrid MinColumnWidth="220" Margin="0,0,0,24">
                <ui:StatCard Title="{l:Tr Logs.Stat.Total}" Value="{Binding Stats.Total, FallbackValue='—'}"
                             Icon="{StaticResource IconDocument}" Kind="Primary" />
                <ui:StatCard Title="{l:Tr Logs.Stat.Today}" Value="{Binding Stats.Today, FallbackValue='—'}"
                             Icon="{StaticResource IconClock}" Kind="Info" />
                <ui:StatCard Title="{l:Tr Logs.Stat.Last7Days}" Value="{Binding Stats.Last7Days, FallbackValue='—'}"
                             Icon="{StaticResource IconCalendar}" Kind="Success" />
                <ui:StatCard Title="{l:Tr Logs.Stat.FailedSignIns}" Value="{Binding Stats.FailedSignInsToday, FallbackValue='—'}"
                             Icon="{StaticResource IconWarning}" Kind="Danger" />
            </ui:ResponsiveGrid>

            <!-- Table -->
            <ui:DataTable Height="560"
                          IsLoading="{Binding IsLoading}"
                          IsEmpty="{Binding IsEmpty}"
                          HasError="{Binding HasLoadError}"
                          ErrorTitle="{l:TrKey LoadErrorTitleKey}"
                          ErrorDescription="{l:TrKey LoadErrorDescriptionKey}"
                          RetryCommand="{Binding RefreshCommand}"
                          FirstRowNumber="{Binding FirstRowNumber}">
                <ui:DataTable.Toolbar>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:SearchBox MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      Text="{Binding Search}"
                                      SearchCommand="{Binding SearchCommand}" />
                        <TextBlock Grid.Column="1" Classes="caption muted" Text="{l:Tr Logs.Records, Arg=TotalCount}" VerticalAlignment="Center" />
                    </Grid>
                </ui:DataTable.Toolbar>

                <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:DataType="logs:ActivityLogListItemDto" Header="{l:Tr Logs.Col.Time}" Width="150"
                                           Binding="{Binding OccurredAt, Converter={x:Static conv:ValueConverters.LocalDateTime}}"
                                           IsReadOnly="True" />
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.User}" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:ActivityLogListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center"
                                               Text="{Binding Username, Converter={x:Static conv:ValueConverters.Truncate}, ConverterParameter=28}"
                                               ToolTip.Tip="{Binding Username}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Action}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:ActivityLogListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="Medium"
                                               Text="{l:TrKey Action, Prefix=Action.}"
                                               ToolTip.Tip="{Binding Action}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Module}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:ActivityLogListItemDto">
                                    <ui:Badge Margin="12,0" Text="{Binding Module}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Logs.Col.Description}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:ActivityLogListItemDto">
                                    <TextBlock Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Description, Converter={x:Static conv:ValueConverters.Truncate}, ConverterParameter=70}"
                                               ToolTip.Tip="{Binding Description}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="logs:ActivityLogListItemDto">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space1}" Margin="8,0" VerticalAlignment="Center">
                                        <ui:IconButton Classes="ghost sm"
                                                       Icon="{StaticResource IconEye}"
                                                       ToolTip.Tip="{l:Tr Common.View}"
                                                       Command="{Binding $parent[DataGrid].((vm:ActivityLogsViewModel)DataContext).ViewDetailsCommand}"
                                                       CommandParameter="{Binding}" />
                                        <ui:IconButton Classes="ghost destructive sm"
                                                       Icon="{StaticResource IconDelete}"
                                                       ToolTip.Tip="{l:Tr Common.Delete}"
                                                       Command="{Binding $parent[DataGrid].((vm:ActivityLogsViewModel)DataContext).DeleteCommand}"
                                                       CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ui:DataTable.Footer>
                    <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="{Binding PageCount}" IsEnabled="{Binding !IsLoading}" />
                </ui:DataTable.Footer>
            </ui:DataTable>
        </StackPanel>
    </ScrollViewer>
</UserControl>
