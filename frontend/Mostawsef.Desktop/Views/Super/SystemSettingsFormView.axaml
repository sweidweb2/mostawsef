<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Super"
             x:Class="Mostawsef.Desktop.Views.Super.SystemSettingsFormView"
             x:DataType="vm:SystemSettingsFormViewModel">
    <StackPanel Spacing="{StaticResource GapGrid}">
        <ui:Alert Kind="Danger" Text="{l:TrKey {Binding FormErrorKey}}" />

        <ui:FormField Label="{l:Tr SystemSettings.Field.BackupPath}"
                      Hint="{l:Tr SystemSettings.BackupPathHint}"
                      Error="{l:FieldError {Binding Errors[BackupPath]}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapControls}">
                <TextBox Name="BackupPathBox"
                         Text="{Binding BackupPath}"
                         PlaceholderText="{l:Tr SystemSettings.BackupPathPlaceholder}" />
                <Button Name="BrowseBackupFolderButton"
                        Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding BrowseBackupFolderCommand}"
                        Content="{l:Tr SystemSettings.Browse}" />
            </Grid>
        </ui:FormField>

        <ui:FormField Label="{l:Tr SystemSettings.Field.MaintenanceMode}" Hint="{l:Tr SystemSettings.MaintenanceHint}">
            <ToggleSwitch Name="MaintenanceModeSwitch"
                          IsChecked="{Binding MaintenanceMode}"
                          OnContent="{l:Tr SystemSettings.On}"
                          OffContent="{l:Tr SystemSettings.Off}" />
        </ui:FormField>
    </StackPanel>
</UserControl>
