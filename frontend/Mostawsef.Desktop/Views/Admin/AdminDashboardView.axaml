<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.AdminDashboardView"
             x:DataType="vm:AdminDashboardViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.Dashboard}" Subtitle="{Binding Welcome}" />
            <ui:Card>
                <ui:EmptyState Margin="0,32"
                               Icon="{StaticResource IconDashboard}"
                               Title="{l:Tr Dashboard.Empty.Title}"
                               Description="{l:Tr Dashboard.Empty.Description}" />
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
