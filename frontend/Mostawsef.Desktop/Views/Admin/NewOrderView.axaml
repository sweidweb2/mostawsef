<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:common="using:Mostawsef.Contracts.Common"
             xmlns:orders="using:Mostawsef.Contracts.Orders"
             xmlns:patients="using:Mostawsef.Contracts.Patients"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.NewOrderView"
             x:DataType="vm:NewOrderViewModel">
    <UserControl.Styles>
        <Style Selector="Button.catalog-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="{StaticResource PaddingCardCompact}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="Border.order-item">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="{StaticResource PaddingCardCompact}" />
        </Style>
    </UserControl.Styles>

    <ui:LoadingOverlay Name="PreparingOverlay" IsLoading="{Binding IsPreparing}">
        <DockPanel Classes="page">
            <ui:PageHeader DockPanel.Dock="Top" Title="{l:Tr NewOrder.Title}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapGrid}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}" VerticalAlignment="Center"
                                    IsVisible="{Binding HasPayment}">
                            <TextBlock Classes="caption muted" VerticalAlignment="Center" Text="{l:Tr NewOrder.Remaining}" />
                            <TextBlock Name="RemainingText" Classes="strong" VerticalAlignment="Center" Text="{l:Money {Binding Remaining}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}" VerticalAlignment="Center">
                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr NewOrder.Labs}" />
                            <TextBlock Name="LabsText" Classes="strong" VerticalAlignment="Center" Text="{l:Money {Binding LabsTotal}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}" VerticalAlignment="Center">
                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr NewOrder.Total}" />
                            <TextBlock Name="TotalText" Classes="h3" VerticalAlignment="Center" Text="{l:Money {Binding Total}}" />
                        </StackPanel>
                        <Button Name="CreateButton" Classes="primary" Command="{Binding SaveCommand}">
                            <Panel>
                                <TextBlock Text="{l:Tr NewOrder.Create}" IsVisible="{Binding !IsBusy}" />
                                <ui:Spinner Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource BrushOnPrimary}"
                                            IsVisible="{Binding IsBusy}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:Alert Name="FormError" DockPanel.Dock="Top" Margin="0,0,0,12" Kind="Danger" Text="{l:TrKey {Binding FormErrorKey}}" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource GapStack}">
                    <!-- Patient -->
                    <ui:Card Name="PatientColumn" Classes="outlined" Padding="0" Title="{l:Tr NewOrder.Patient}">
                        <StackPanel Margin="{StaticResource PaddingCard}" Spacing="{StaticResource GapStack}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                <Button Name="ExistingPatientButton" Classes="ghost sm" Classes.selected="{Binding !IsNewPatient}"
                                        Content="{l:Tr NewOrder.ExistingPatient}" Command="{Binding ChooseExistingPatientCommand}" />
                                <Button Name="NewPatientButton" Classes="ghost sm" Classes.selected="{Binding IsNewPatient}"
                                        Content="{l:Tr NewOrder.NewPatient}" Command="{Binding ChooseNewPatientCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="{StaticResource GapControls}" IsVisible="{Binding !IsNewPatient}">
                                <Border Name="SelectedPatientCard" Classes="order-item" IsVisible="{Binding HasSelectedPatient}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapControls}">
                                        <StackPanel Spacing="{StaticResource SpaceHalf}">
                                            <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding SelectedPatient.FullName, FallbackValue=''}" />
                                            <TextBlock Classes="caption muted" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       Text="{Binding SelectedPatient.Phone, FallbackValue=''}" />
                                        </StackPanel>
                                        <Button Name="ChangePatientButton" Grid.Column="1" Classes="link" VerticalAlignment="Center"
                                                Content="{l:Tr NewOrder.ChangePatient}" Command="{Binding ChangePatientCommand}" />
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="{StaticResource GapControls}" IsVisible="{Binding !HasSelectedPatient}">
                                    <ui:FormField Error="{l:FieldError {Binding Errors[PatientId]}}">
                                        <AutoCompleteBox Name="PatientSearchBox"
                                                         SelectedItem="{Binding PatientPick}"
                                                         Text="{Binding PatientSearch}"
                                                         ValueMemberBinding="{Binding FullName, DataType={x:Type patients:PatientDto}}"
                                                         MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                                         PlaceholderText="{l:Tr NewOrder.PatientSearchPlaceholder}"
                                                         MinimumPrefixLength="{x:Static common:PageQuery.MinSearchLength}"
                                                         MinimumPopulateDelay="0:0:0.250"
                                                         FilterMode="None"
                                                         HorizontalAlignment="Stretch"
                                                         Loaded="PatientSearchBox_OnLoaded">
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="patients:PatientDto">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapControls}">
                                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" />
                                                        <TextBlock Grid.Column="1" Classes="muted" FlowDirection="LeftToRight" Text="{Binding Phone}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                    </ui:FormField>
                                    <ui:Spinner HorizontalAlignment="Center" IsVisible="{Binding IsLoadingPatients}" />
                                    <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{l:Tr NewOrder.NoPatientsFound}"
                                               IsVisible="{Binding NoPatientsFound}" />
                                </StackPanel>
                            </StackPanel>

                            <ContentControl Name="NewPatientForm" Content="{Binding NewPatientFormContent}" IsVisible="{Binding IsNewPatient}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Tests: selected + catalog -->
                    <ui:ResponsiveGrid MinColumnWidth="280" MaxColumns="2"
                                       ColumnSpacing="{StaticResource GapGrid}" RowSpacing="{StaticResource GapGrid}">
                        <ui:Card Name="TestsColumn" Classes="outlined" Padding="0" Title="{l:Tr NewOrder.SelectedTestsCount, Arg={Binding SelectedTests.Count}}">
                            <DockPanel>
                                <TextBlock Name="ItemsError"
                                           DockPanel.Dock="Top"
                                           Margin="{StaticResource PaddingCardCompact}"
                                           Classes="caption danger"
                                           TextWrapping="Wrap"
                                           Text="{l:FieldError {Binding Errors[Items]}}"
                                           IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Panel MinHeight="180" MaxHeight="{StaticResource NewOrderListMaxHeight}">
                                    <ItemsControl Name="SelectedTestsList"
                                                  Classes="virtualizing"
                                                  MaxHeight="{StaticResource NewOrderListMaxHeight}"
                                                  Margin="{StaticResource PaddingCard}"
                                                  ItemsSource="{Binding SelectedTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderItemDraft">
                                                <Border Classes="order-item" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource GapControls}">
                                                        <StackPanel Spacing="{StaticResource SpaceHalf}">
                                                            <TextBlock Classes="caption muted" Text="{Binding Test.Code}" />
                                                            <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding Test.Name}" />
                                                            <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{l:FieldError {Binding Errors[LabTestId]}}"
                                                                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="caption muted" VerticalAlignment="Center"
                                                                   Text="{l:Money {Binding Test.LabCost}}" />
                                                        <ui:IconButton Grid.Column="2"
                                                                       Classes="ghost destructive sm"
                                                                       VerticalAlignment="Center"
                                                                       Icon="{StaticResource IconClose}"
                                                                       ToolTip.Tip="{l:Tr NewOrder.RemoveTest}"
                                                                       Command="{Binding $parent[ItemsControl].((vm:NewOrderViewModel)DataContext).RemoveTestCommand}"
                                                                       CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:EmptyState Name="NoTestsState"
                                                   IsVisible="{Binding !HasSelectedTests}"
                                                   Icon="{StaticResource IconLab}"
                                                   Title="{l:Tr NewOrder.NoTests}"
                                                   Description="{l:Tr NewOrder.NoTestsHint}" />
                                </Panel>
                            </DockPanel>
                        </ui:Card>

                        <ui:Card Name="CatalogColumn" Classes="outlined" Padding="0" Title="{l:Tr NewOrder.Catalog}">
                            <DockPanel>
                                <ui:SearchBox Name="CatalogSearchBox"
                                              DockPanel.Dock="Top"
                                              Margin="20,12,20,0"
                                              Text="{Binding CatalogSearch}"
                                              MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                              PlaceholderText="{l:Tr LabTests.SearchPlaceholder}" />
                                <Panel MinHeight="180" MaxHeight="{StaticResource NewOrderListMaxHeight}">
                                    <ItemsControl Name="CatalogList"
                                                  Classes="virtualizing"
                                                  MaxHeight="{StaticResource NewOrderListMaxHeight}"
                                                  Margin="{StaticResource PaddingCardCompact}"
                                                  ItemsSource="{Binding Catalog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CatalogTestItem">
                                                <Button Classes="secondary catalog-card"
                                                        Margin="0,0,0,8"
                                                        IsEnabled="{Binding !IsSelected}"
                                                        ToolTip.Tip="{Binding Test.Name}"
                                                        Command="{Binding $parent[ItemsControl].((vm:NewOrderViewModel)DataContext).AddTestCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Spacing="{StaticResource SpaceHalf}">
                                                        <TextBlock Classes="caption muted" TextTrimming="CharacterEllipsis" Text="{Binding Test.Code}" />
                                                        <TextBlock FontWeight="Medium" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Test.Name}" />
                                                        <TextBlock Classes="caption" Text="{l:Money {Binding Test.LabCost}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:EmptyState Name="CatalogEmptyState"
                                                   IsVisible="{Binding IsCatalogEmpty}"
                                                   Icon="{StaticResource IconSearch}"
                                                   Title="{l:Tr NewOrder.CatalogEmpty}" />
                                    <ui:ErrorState IsVisible="{Binding HasCatalogError}"
                                                   Title="{l:TrKey {Binding CatalogErrorTitleKey}}"
                                                   Description="{l:TrKey {Binding CatalogErrorDescriptionKey}}"
                                                   RetryCommand="{Binding RetryCatalogCommand}" />
                                    <ui:LoadingOverlay IsLoading="{Binding IsCatalogLoading}" />
                                </Panel>
                            </DockPanel>
                        </ui:Card>
                    </ui:ResponsiveGrid>

                    <!-- Charge + first payment -->
                    <ui:Card Name="ReviewColumn" Classes="outlined" Padding="0" Title="{l:Tr NewOrder.Charge}">
                        <StackPanel Margin="{StaticResource PaddingCard}" Spacing="{StaticResource GapStack}">
                            <ui:FormField Label="{l:Tr NewOrder.Addon}" Error="{l:FieldError {Binding Errors[Addon]}}"
                                          HorizontalAlignment="Left" Width="260">
                                <NumericUpDown Name="AddonBox"
                                               Value="{Binding Addon}"
                                               Minimum="0"
                                               Maximum="{Binding MaxAddon}"
                                               ClipValueToMinMax="True"
                                               ShowButtonSpinner="False"
                                               FormatString="0.00"
                                               PlaceholderText="{l:Tr LabTests.Field.AmountPlaceholder}"
                                               HorizontalAlignment="Stretch"
                                               ToolTip.Tip="{l:Tr NewOrder.AddonHint}" />
                            </ui:FormField>

                            <ui:Divider />

                            <TextBlock Classes="h4" Text="{l:Tr NewOrder.FirstPayment}" />
                            <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{l:Tr NewOrder.FirstPaymentHint}" />
                            <ui:ResponsiveGrid MinColumnWidth="160" MaxColumns="2"
                                               ColumnSpacing="{StaticResource GapGrid}" RowSpacing="{StaticResource GapGrid}">
                                <ui:FormField Label="{l:Tr NewOrder.PaymentAmount}" Error="{l:FieldError {Binding Errors[PaymentAmount]}}">
                                    <NumericUpDown Name="PaymentAmountBox"
                                                   Value="{Binding PaymentAmount}"
                                                   Minimum="0"
                                                   Maximum="{Binding MaxPayableAmount}"
                                                   ClipValueToMinMax="True"
                                                   FormatString="0.00"
                                                   PlaceholderText="{l:Tr LabTests.Field.AmountPlaceholder}"
                                                   HorizontalAlignment="Stretch" />
                                </ui:FormField>
                                <ui:FormField Label="{l:Tr NewOrder.PaymentMethod}" Error="{l:FieldError {Binding Errors[PaymentMethod]}}">
                                    <ComboBox Name="PaymentMethodBox"
                                              ItemsSource="{Binding PaymentMethodOptions}"
                                              SelectedItem="{Binding PaymentMethod}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{l:TrKey {Binding}, Prefix=PaymentMethod.}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </ui:FormField>
                                <ui:FormField ui:ResponsiveGrid.ColumnSpan="0" Label="{l:Tr NewOrder.PaymentNotes}" Error="{l:FieldError {Binding Errors[PaymentNotes]}}">
                                    <TextBox Name="PaymentNotesBox"
                                             Text="{Binding PaymentNotes}"
                                             MaxLength="{x:Static orders:OrderRules.PaymentNotesMaxLength}"
                                             PlaceholderText="{l:Tr NewOrder.PaymentNotesPlaceholder}" />
                                </ui:FormField>
                            </ui:ResponsiveGrid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </ui:LoadingOverlay>
</UserControl>
