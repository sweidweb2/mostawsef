<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:common="using:Mostawsef.Contracts.Common"
             xmlns:orders="using:Mostawsef.Contracts.Orders"
             xmlns:patients="using:Mostawsef.Contracts.Patients"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.NewOrderView"
             x:DataType="vm:NewOrderViewModel">
    <UserControl.Styles>
        <Style Selector="Button.catalog-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCardCompact}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="Border.order-item">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCardCompact}" />
        </Style>

        <Style Selector="Button.step-node">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControlSm}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.step-node:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.step-node:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.step-circle">
            <Setter Property="Width" Value="{DynamicResource AvatarSize}" />
            <Setter Property="Height" Value="{DynamicResource AvatarSize}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderWidthThick}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.step-circle.current">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="Border.step-circle.complete">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="Border.step-circle.missing">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        </Style>

        <Style Selector="Border.step-circle TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>
        <Style Selector="Border.step-circle.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
        </Style>
        <Style Selector="Border.step-circle.missing TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="Border.step-circle.complete PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Width" Value="{DynamicResource IconSize}" />
            <Setter Property="Height" Value="{DynamicResource IconSize}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.step-circle.missing PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            <Setter Property="Width" Value="{DynamicResource IconSize}" />
            <Setter Property="Height" Value="{DynamicResource IconSize}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.step-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.step-label.current">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="TextBlock.step-label.missing">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
        </Style>

        <Style Selector="Border.step-line">
            <Setter Property="Height" Value="{DynamicResource FocusRingWidth}" />
            <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.step-line.complete">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Outer Panel keeps the step marker as DataContext (ContentPresenter owns the root). Order is rebound inside. -->
        <DataTemplate x:DataType="vm:NewOrderPatientStep">
            <Panel>
            <ui:Card Name="PatientColumn" Padding="0" Title="{l:Tr NewOrder.Patient}" DataContext="{Binding Order}">
                <ScrollViewer>
                    <StackPanel Margin="{DynamicResource PaddingCard}" Spacing="{DynamicResource GapStack}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space1}">
                            <Button Name="ExistingPatientButton" Classes="ghost sm" Classes.selected="{Binding !IsNewPatient}"
                                    Content="{l:Tr NewOrder.ExistingPatient}" Command="{Binding ChooseExistingPatientCommand}" />
                            <Button Name="NewPatientButton" Classes="ghost sm" Classes.selected="{Binding IsNewPatient}"
                                    Content="{l:Tr NewOrder.NewPatient}" Command="{Binding ChooseNewPatientCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="{DynamicResource GapControls}" IsVisible="{Binding !IsNewPatient}">
                            <Border Name="SelectedPatientCard" Classes="order-item" IsVisible="{Binding HasSelectedPatient}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource GapControls}">
                                    <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                        <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding SelectedPatient.FullName, FallbackValue=''}" />
                                        <TextBlock Classes="caption muted" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                   Text="{Binding SelectedPatient.Phone, FallbackValue=''}" />
                                    </StackPanel>
                                    <Button Name="ChangePatientButton" Grid.Column="1" Classes="link" VerticalAlignment="Center"
                                            Content="{l:Tr NewOrder.ChangePatient}" Command="{Binding ChangePatientCommand}" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="{DynamicResource GapControls}" IsVisible="{Binding !HasSelectedPatient}">
                                <ui:FormField Error="{l:FieldError PatientId}">
                                    <AutoCompleteBox Name="PatientSearchBox"
                                                     SelectedItem="{Binding PatientPick}"
                                                     Text="{Binding PatientSearch}"
                                                     ValueMemberBinding="{Binding FullName, DataType={x:Type patients:PatientDto}}"
                                                     MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                                     PlaceholderText="{l:Tr NewOrder.PatientSearchPlaceholder}"
                                                     MinimumPrefixLength="{x:Static common:PageQuery.MinSearchLength}"
                                                     MinimumPopulateDelay="0:0:0.250"
                                                     FilterMode="None"
                                                     HorizontalAlignment="Stretch"
                                                     Loaded="PatientSearchBox_OnLoaded">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="patients:PatientDto">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource GapControls}">
                                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" />
                                                    <TextBlock Grid.Column="1" Classes="muted" FlowDirection="LeftToRight" Text="{Binding Phone}" />
                                                </Grid>
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </ui:FormField>
                                <ui:Spinner HorizontalAlignment="Center" IsVisible="{Binding IsLoadingPatients}" />
                                <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{l:Tr NewOrder.NoPatientsFound}"
                                           IsVisible="{Binding NoPatientsFound}" />
                            </StackPanel>
                        </StackPanel>

                        <ContentControl Name="NewPatientForm" Content="{Binding NewPatientFormContent}" />
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
            </Panel>
        </DataTemplate>

        <DataTemplate x:DataType="vm:NewOrderTestsStep">
            <Panel>
            <Grid DataContext="{Binding Order}" ColumnDefinitions="*,1.4*" ColumnSpacing="{DynamicResource GapGrid}">
                <ui:Card Name="TestsColumn" Padding="0" Title="{l:Tr NewOrder.SelectedTestsCount, Arg=SelectedTests.Count}">
                    <DockPanel>
                        <TextBlock Name="ItemsError"
                                   DockPanel.Dock="Top"
                                   Margin="{DynamicResource PaddingCardCompact}"
                                   Classes="caption danger"
                                   TextWrapping="Wrap"
                                   Text="{l:FieldError Items}"
                                   IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Panel>
                            <ItemsControl Name="SelectedTestsList"
                                          Classes="virtualizing"
                                          Margin="{DynamicResource PaddingCard}"
                                          ItemsSource="{Binding SelectedTests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OrderItemDraft">
                                        <Border Classes="order-item" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource GapControls}">
                                                <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                                    <TextBlock Classes="caption muted" Text="{Binding Test.Code}" />
                                                    <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding Test.Name}" />
                                                    <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{l:FieldError LabTestId}"
                                                               IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Classes="strong" VerticalAlignment="Center"
                                                           Text="{l:Money Test.Price}" />
                                                <ui:IconButton Grid.Column="2"
                                                               Classes="ghost destructive sm"
                                                               VerticalAlignment="Center"
                                                               Icon="{StaticResource IconClose}"
                                                               ToolTip.Tip="{l:Tr NewOrder.RemoveTest}"
                                                               Command="{Binding $parent[ItemsControl].((vm:NewOrderViewModel)DataContext).RemoveTestCommand}"
                                                               CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:EmptyState Name="NoTestsState"
                                           IsVisible="{Binding !HasSelectedTests}"
                                           Icon="{StaticResource IconLab}"
                                           Title="{l:Tr NewOrder.NoTests}"
                                           Description="{l:Tr NewOrder.NoTestsHint}" />
                        </Panel>
                    </DockPanel>
                </ui:Card>

                <ui:Card Name="CatalogColumn" Grid.Column="1" Padding="0" Title="{l:Tr NewOrder.Catalog}">
                    <DockPanel>
                        <ui:SearchBox Name="CatalogSearchBox"
                                      DockPanel.Dock="Top"
                                      Margin="20,12,20,0"
                                      Text="{Binding CatalogSearch}"
                                      MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                      PlaceholderText="{l:Tr LabTests.SearchPlaceholder}" />
                        <Panel>
                            <ItemsControl Name="CatalogList"
                                          Classes="virtualizing"
                                          Margin="{DynamicResource PaddingCardCompact}"
                                          ItemsSource="{Binding Catalog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogTestItem">
                                        <Button Classes="secondary catalog-card"
                                                Margin="0,0,0,8"
                                                IsEnabled="{Binding !IsSelected}"
                                                ToolTip.Tip="{Binding Test.Name}"
                                                Command="{Binding $parent[ItemsControl].((vm:NewOrderViewModel)DataContext).AddTestCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                                <TextBlock Classes="caption muted" TextTrimming="CharacterEllipsis" Text="{Binding Test.Code}" />
                                                <TextBlock FontWeight="Medium" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Test.Name}" />
                                                <TextBlock Classes="caption" Text="{l:Money Test.Price}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:EmptyState Name="CatalogEmptyState"
                                           IsVisible="{Binding IsCatalogEmpty}"
                                           Icon="{StaticResource IconSearch}"
                                           Title="{l:Tr NewOrder.CatalogEmpty}" />
                            <ui:ErrorState IsVisible="{Binding HasCatalogError}"
                                           Title="{l:TrKey CatalogErrorTitleKey}"
                                           Description="{l:TrKey CatalogErrorDescriptionKey}"
                                           RetryCommand="{Binding RetryCatalogCommand}" />
                            <ui:LoadingOverlay IsLoading="{Binding IsCatalogLoading}" />
                        </Panel>
                    </DockPanel>
                </ui:Card>
            </Grid>
            </Panel>
        </DataTemplate>

        <DataTemplate x:DataType="vm:NewOrderReviewStep">
            <Panel>
            <ui:Card Name="ReviewColumn" Padding="0" Title="{l:Tr NewOrder.Review}" DataContext="{Binding Order}">
                <ScrollViewer>
                    <StackPanel Margin="{DynamicResource PaddingCard}" Spacing="{DynamicResource GapStack}">
                        <ui:ResponsiveGrid MinColumnWidth="160" MaxColumns="2"
                                           ColumnSpacing="{DynamicResource GapGrid}" RowSpacing="{DynamicResource GapGrid}">
                            <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                <TextBlock Classes="muted" Text="{l:Tr NewOrder.Total}" />
                                <TextBlock Name="TotalText" Classes="h3" Text="{l:Money Total}" />
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource GapControls}" IsVisible="{Binding HasPayment}">
                                    <TextBlock Classes="caption muted" Text="{l:Tr NewOrder.Remaining}" />
                                    <TextBlock Name="RemainingText" Classes="caption strong" Text="{l:Money Remaining}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                <TextBlock Classes="caption muted" Text="{l:Tr NewOrder.Addon}" />
                                <NumericUpDown Name="AddonBox"
                                               Value="{Binding Addon}"
                                               Minimum="0"
                                               Maximum="{Binding MaxAddon}"
                                               ClipValueToMinMax="True"
                                               ShowButtonSpinner="False"
                                               FormatString="0.00"
                                               PlaceholderText="{l:Tr LabTests.Field.AmountPlaceholder}"
                                               ToolTip.Tip="{l:Tr NewOrder.AddonHint}" />
                                <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{l:FieldError Addon}"
                                           IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </ui:ResponsiveGrid>

                        <TextBlock Classes="h4" Text="{l:Tr NewOrder.FirstPayment}" />
                        <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{l:Tr NewOrder.FirstPaymentHint}" />
                        <ui:ResponsiveGrid MinColumnWidth="160" MaxColumns="2"
                                           ColumnSpacing="{DynamicResource GapGrid}" RowSpacing="{DynamicResource GapGrid}">
                            <ui:FormField Label="{l:Tr NewOrder.PaymentAmount}" Error="{l:FieldError PaymentAmount}">
                                <NumericUpDown Name="PaymentAmountBox"
                                               Value="{Binding PaymentAmount}"
                                               Minimum="0"
                                               Maximum="{Binding MaxPayableAmount}"
                                               ClipValueToMinMax="True"
                                               FormatString="0.00"
                                               PlaceholderText="{l:Tr LabTests.Field.AmountPlaceholder}"
                                               HorizontalAlignment="Stretch" />
                            </ui:FormField>
                            <ui:FormField Label="{l:Tr NewOrder.PaymentMethod}" Error="{l:FieldError PaymentMethod}">
                                <ComboBox Name="PaymentMethodBox"
                                          ItemsSource="{Binding PaymentMethodOptions}"
                                          SelectedItem="{Binding PaymentMethod}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{l:TrKey ., Prefix=PaymentMethod.}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:FormField>
                            <ui:FormField ui:ResponsiveGrid.ColumnSpan="0" Label="{l:Tr NewOrder.PaymentNotes}" Error="{l:FieldError PaymentNotes}">
                                <TextBox Name="PaymentNotesBox"
                                         Text="{Binding PaymentNotes}"
                                         MaxLength="{x:Static orders:OrderRules.PaymentNotesMaxLength}"
                                         PlaceholderText="{l:Tr NewOrder.PaymentNotesPlaceholder}" />
                            </ui:FormField>
                        </ui:ResponsiveGrid>

                        <ui:Divider />

                        <TextBlock Classes="h4" Text="{l:Tr NewOrder.SelectedTestsCount, Arg=SelectedTests.Count}" />
                        <ItemsControl Classes="virtualizing"
                                      MaxHeight="320"
                                      ItemsSource="{Binding SelectedTests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrderItemDraft">
                                    <Border Classes="order-item" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource GapControls}">
                                            <StackPanel Spacing="{DynamicResource SpaceHalf}">
                                                <TextBlock Classes="caption muted" Text="{Binding Test.Code}" />
                                                <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding Test.Name}" />
                                                <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{l:FieldError LabTestId}"
                                                           IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="strong" VerticalAlignment="Center"
                                                       Text="{l:Money Test.Price}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
            </Panel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel Classes="page">
        <Button Name="BackButton" DockPanel.Dock="Top" Classes="ghost sm" HorizontalAlignment="Left"
                Margin="0,0,0,8" Command="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space1}">
                <PathIcon Data="{StaticResource IconChevronStart}" />
                <TextBlock Text="{l:Tr OrderDetails.BackToOrders}" />
            </StackPanel>
        </Button>

        <ui:Alert Name="FormError" DockPanel.Dock="Top" Margin="0,0,0,12" Kind="Danger" Text="{l:TrKey FormErrorKey}" />

        <Grid Name="StepIndicator" DockPanel.Dock="Top" Margin="{DynamicResource PaddingCardCompact}">
            <Grid Height="{DynamicResource AvatarSize}" VerticalAlignment="Top" ColumnDefinitions="*,*">
                <!-- Inset by AvatarSize so the line meets each circle's edge. -->
                <Border Classes="step-line" Classes.complete="{Binding PatientStepItem.LineComplete}" Margin="40,0" />
                <Border Grid.Column="1" Classes="step-line" Classes.complete="{Binding TestsStepItem.LineComplete}" Margin="40,0" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderStepItem">
                        <Button Classes="step-node"
                                Command="{Binding $parent[ItemsControl].((vm:NewOrderViewModel)DataContext).GoToStepCommand}"
                                CommandParameter="{Binding Index}">
                            <StackPanel>
                                <Border Classes="step-circle"
                                        Classes.current="{Binding IsCurrent}"
                                        Classes.complete="{Binding ShowCheck}"
                                        Classes.missing="{Binding ShowMissing}">
                                    <Panel>
                                        <TextBlock Text="{Binding Number}" IsVisible="{Binding ShowNumber}" />
                                        <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding ShowCheck}" />
                                        <PathIcon Data="{StaticResource IconWarning}" IsVisible="{Binding ShowMissing}" />
                                    </Panel>
                                </Border>
                                <TextBlock Classes="step-label"
                                           Classes.current="{Binding IsCurrent}"
                                           Classes.missing="{Binding ShowMissing}"
                                           Text="{l:TrKey TitleKey}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="{DynamicResource PaddingCardCompact}"
                Background="{DynamicResource BrushSurface}" CornerRadius="{DynamicResource RadiusMd}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource GapGrid}">
                <Button Name="PreviousStepButton" Classes="secondary"
                        Content="{l:Tr NewOrder.Previous}"
                        Command="{Binding PreviousStepCommand}"
                        IsVisible="{Binding CanGoBack}" />
                <Button Name="NextStepButton" Grid.Column="2" Classes="primary"
                        Content="{l:Tr NewOrder.Next}"
                        Command="{Binding NextStepCommand}"
                        IsVisible="{Binding ShowNext}" />
                <Button Name="CreateButton" Grid.Column="2" Classes="primary" Command="{Binding SaveCommand}"
                        IsVisible="{Binding ShowSave}">
                    <Panel>
                        <TextBlock Text="{l:Tr NewOrder.Create}" IsVisible="{Binding !IsBusy}" />
                        <ui:Spinner Width="20"
                                    Height="20"
                                    Foreground="{DynamicResource BrushOnPrimary}"
                                    IsVisible="{Binding IsBusy}" />
                    </Panel>
                </Button>
            </Grid>
        </Border>

        <ui:LoadingOverlay Name="PreparingOverlay" IsLoading="{Binding IsPreparing}">
            <!-- Caches each step's view; ContentControl was rebuilding the Tests catalog on every Next/Back. -->
            <ui:CachedContentHost Name="StepHost" Content="{Binding StepContent}" />
        </ui:LoadingOverlay>
    </DockPanel>
</UserControl>
