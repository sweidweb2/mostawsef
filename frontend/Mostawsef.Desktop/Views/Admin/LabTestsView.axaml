<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:tests="using:Mostawsef.Contracts.LabTests"
             xmlns:common="using:Mostawsef.Contracts.Common"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.LabTestsView"
             x:DataType="vm:LabTestsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.LabTests}" Subtitle="{l:Tr LabTests.Subtitle}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                        <Button Classes="secondary" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="{l:Tr Common.Refresh}" />
                            </StackPanel>
                        </Button>
                        <Button Name="ExportButton" Classes="secondary" Command="{Binding ExportCommand}" ToolTip.Tip="{l:Tr LabTests.ExportHint}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconDownload}" IsVisible="{Binding !IsExporting}" />
                                <ui:Spinner Width="16" Height="16" IsVisible="{Binding IsExporting}" />
                                <TextBlock Text="{l:Tr Common.Export}" />
                            </StackPanel>
                        </Button>
                        <Button Name="AddTestButton" Classes="primary" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{l:Tr LabTests.Add}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:DataTable Height="560"
                          IsLoading="{Binding IsLoading}"
                          IsEmpty="{Binding IsEmpty}"
                          HasError="{Binding HasLoadError}"
                          ErrorTitle="{l:TrKey {Binding LoadErrorTitleKey}}"
                          ErrorDescription="{l:TrKey {Binding LoadErrorDescriptionKey}}"
                          RetryCommand="{Binding RefreshCommand}"
                          FirstRowNumber="{Binding FirstRowNumber}">
                <ui:DataTable.Toolbar>
                    <!-- Equal side columns keep the search box centered in the row. -->
                    <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="{StaticResource GapControls}">
                        <ui:SearchBox Name="SearchBox"
                                      Grid.Column="1"
                                      Text="{Binding Search}"
                                      MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                      PlaceholderText="{l:Tr LabTests.SearchPlaceholder}"
                                      SearchCommand="{Binding SearchCommand}" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{StaticResource GapControls}">
                            <TextBlock Classes="caption muted" Text="{l:Tr LabTests.Records, Arg={Binding DisplayTotal}}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                <ui:IconButton Name="TableViewButton"
                                               Classes="ghost sm"
                                               Classes.selected="{Binding !IsGridView}"
                                               Icon="{StaticResource IconList}"
                                               ToolTip.Tip="{l:Tr Common.TableView}"
                                               Command="{Binding ShowTableCommand}" />
                                <ui:IconButton Name="GridViewButton"
                                               Classes="ghost sm"
                                               Classes.selected="{Binding IsGridView}"
                                               Icon="{StaticResource IconGrid}"
                                               ToolTip.Tip="{l:Tr Common.GridView}"
                                               Command="{Binding ShowGridCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:DataTable.Toolbar>

                <Panel>
                    <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="False" IsVisible="{Binding !IsGridView}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="tests:LabTestDto">
                                        <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr LabTests.Col.Code}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="tests:LabTestDto">
                                        <Grid Margin="12,0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Code}" ToolTip.Tip="{Binding Code}" />
                                            <ui:CopyButton Grid.Column="1" Classes="sm" Text="{Binding Code}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr LabTests.Col.Name}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="tests:LabTestDto">
                                        <Grid Margin="12,0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                            <ui:CopyButton Grid.Column="1" Classes="sm" Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="tests:LabTestDto" Header="{l:Tr LabTests.Col.LabCost}" Width="140"
                                               Binding="{Binding LabCost, Converter={x:Static conv:ValueConverters.Money}}"
                                               IsReadOnly="True" />
                            <DataGridTemplateColumn Header="{l:Tr LabTests.Col.Status}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="tests:LabTestDto">
                                        <Panel Margin="12,0" VerticalAlignment="Center">
                                            <ui:Badge Kind="Success" Text="{l:Tr LabTests.Active}" IsVisible="{Binding IsActive}" />
                                            <ui:Badge Text="{l:Tr LabTests.Inactive}" IsVisible="{Binding !IsActive}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="tests:LabTestDto">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="8,0" VerticalAlignment="Center">
                                            <ui:IconButton Classes="ghost sm"
                                                           Icon="{StaticResource IconEdit}"
                                                           ToolTip.Tip="{l:Tr Common.Edit}"
                                                           Command="{Binding $parent[DataGrid].((vm:LabTestsViewModel)DataContext).EditCommand}"
                                                           CommandParameter="{Binding}" />
                                            <ui:IconButton Classes="ghost destructive sm"
                                                           Icon="{StaticResource IconDelete}"
                                                           ToolTip.Tip="{l:Tr Common.Delete}"
                                                           Command="{Binding $parent[DataGrid].((vm:LabTestsViewModel)DataContext).DeleteCommand}"
                                                           CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- The table has a fixed height, so many cards scroll instead of being cut off. -->
                    <ScrollViewer Name="CardsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding IsGridView}">
                        <ItemsControl Name="CardsGrid"
                                      Margin="{StaticResource PaddingCardCompact}"
                                      ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tests:LabTestDto">
                                    <ui:Card Classes="outlined"
                                             Width="220"
                                             Height="220"
                                             Margin="0,0,12,12"
                                             Title="{Binding Name}"
                                             Subtitle="{Binding Code}">
                                        <ui:Card.HeaderActions>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" VerticalAlignment="Top">
                                                <ui:IconButton Classes="ghost sm"
                                                               Icon="{StaticResource IconEdit}"
                                                               ToolTip.Tip="{l:Tr Common.Edit}"
                                                               Command="{Binding $parent[ItemsControl].((vm:LabTestsViewModel)DataContext).EditCommand}"
                                                               CommandParameter="{Binding}" />
                                                <ui:IconButton Classes="ghost destructive sm"
                                                               Icon="{StaticResource IconDelete}"
                                                               ToolTip.Tip="{l:Tr Common.Delete}"
                                                               Command="{Binding $parent[ItemsControl].((vm:LabTestsViewModel)DataContext).DeleteCommand}"
                                                               CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </ui:Card.HeaderActions>
                                        <DockPanel>
                                            <Panel DockPanel.Dock="Bottom">
                                                <ui:Badge Kind="Success" Text="{l:Tr LabTests.Active}" IsVisible="{Binding IsActive}" />
                                                <ui:Badge Text="{l:Tr LabTests.Inactive}" IsVisible="{Binding !IsActive}" />
                                            </Panel>
                                            <TextBlock Classes="h3" Text="{l:Money {Binding LabCost}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>

                <ui:DataTable.Footer>
                    <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="{Binding PageCount}" IsEnabled="{Binding !IsLoading}" />
                </ui:DataTable.Footer>
            </ui:DataTable>
        </StackPanel>
    </ScrollViewer>
</UserControl>
