<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.ClinicSettingsView"
             x:DataType="vm:ClinicSettingsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.ClinicSettings}" Subtitle="{l:Tr Settings.Subtitle}">
                <ui:PageHeader.Actions>
                    <Button Name="EditSettingsButton" Classes="primary" Command="{Binding EditCommand}"
                            IsEnabled="{Binding Clinic.Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource GapControls}">
                            <PathIcon Data="{StaticResource IconEdit}" />
                            <TextBlock Text="{l:Tr Common.Edit}" />
                        </StackPanel>
                    </Button>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:Card>
                <ui:LoadingOverlay IsLoading="{Binding IsLoading}">
                    <Panel>
                        <ui:DetailsView IsVisible="{Binding Clinic.Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ui:DetailsItem Label="{l:Tr Settings.Field.Name}" Value="{Binding Clinic.Settings.Name}" />
                            <ui:DetailsItem Label="{l:Tr Settings.Field.Address}" Value="{Binding Clinic.Settings.Address}" />
                            <ui:DetailsItem Label="{l:Tr Settings.Field.Phone}" Value="{Binding Clinic.Settings.Phone}" />
                            <ui:DetailsItem Label="{l:Tr Settings.Field.Currency}" Value="{l:TrKey Clinic.Settings.CurrencyCode, Prefix=Currency.}" />
                            <ui:DetailsItem Label="{l:Tr Settings.Field.UpdatedBy}" Value="{Binding Clinic.Settings.UpdatedBy}" />
                        </ui:DetailsView>
                        <ui:ErrorState Margin="0,24"
                                       RetryCommand="{Binding RefreshCommand}"
                                       IsVisible="{Binding HasLoadError}" />
                    </Panel>
                </ui:LoadingOverlay>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
