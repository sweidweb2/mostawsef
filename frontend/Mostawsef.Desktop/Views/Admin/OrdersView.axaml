<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:orders="using:Mostawsef.Contracts.Orders"
             xmlns:common="using:Mostawsef.Contracts.Common"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.OrdersView"
             x:DataType="vm:OrdersViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.Orders}" Subtitle="{l:Tr Orders.Subtitle}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                        <Button Classes="secondary" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="{l:Tr Common.Refresh}" />
                            </StackPanel>
                        </Button>
                        <Button Name="NewOrderButton" Classes="primary" Command="{Binding NewOrderCommand}">
                            <Panel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource GapControls}"
                                            IsVisible="{Binding !IsOpeningNewOrder}">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:Tr Orders.New}" />
                                </StackPanel>
                                <ui:Spinner Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource BrushOnPrimary}"
                                            IsVisible="{Binding IsOpeningNewOrder}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:DataTable Height="560"
                          IsLoading="{Binding ShowLoading}"
                          IsEmpty="{Binding IsEmpty}"
                          HasError="{Binding HasLoadError}"
                          ErrorTitle="{l:TrKey {Binding LoadErrorTitleKey}}"
                          ErrorDescription="{l:TrKey {Binding LoadErrorDescriptionKey}}"
                          RetryCommand="{Binding RefreshCommand}"
                          FirstRowNumber="{Binding FirstRowNumber}">
                <ui:DataTable.Toolbar>
                    <!-- Equal side columns keep the search box centered in the row. -->
                    <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="{StaticResource GapControls}">
                        <ui:SearchBox Name="SearchBox"
                                      Grid.Column="1"
                                      Text="{Binding Search}"
                                      MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                      PlaceholderText="{l:Tr Orders.SearchPlaceholder}"
                                      SearchCommand="{Binding SearchCommand}" />
                        <TextBlock Grid.Column="2"
                                   Classes="caption muted"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{l:Tr Orders.Records, Arg={Binding DisplayTotal}}" />
                    </Grid>
                </ui:DataTable.Toolbar>

                <DataGrid Name="OrdersGrid" Classes="clickable-rows" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="False"
                          LoadingRow="OnLoadingRow" Tapped="OnRowTapped">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="orders:OrderListItemDto">
                                    <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Number}" Width="130" Binding="{Binding Number}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Date}" Width="150"
                                           Binding="{Binding CreatedAt, Converter={x:Static conv:ValueConverters.LocalDateTime}}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Patient}" Width="*" Binding="{Binding PatientName}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Phone}" Width="130" Binding="{Binding PatientPhone}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Tests}" Width="80" Binding="{Binding TestsCount}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Total}" Width="130"
                                           Binding="{Binding Total, Converter={x:Static conv:ValueConverters.Money}}"
                                           IsReadOnly="True" />
                        <DataGridTextColumn x:DataType="orders:OrderListItemDto" Header="{l:Tr Orders.Col.Paid}" Width="130"
                                           Binding="{Binding Paid, Converter={x:Static conv:ValueConverters.Money}}"
                                           IsReadOnly="True" />
                        <DataGridTemplateColumn Header="{l:Tr Orders.Col.Status}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="orders:OrderListItemDto">
                                    <ui:Badge Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Kind="{Binding Status, Converter={x:Static conv:ValueConverters.OrderStatusToBadgeKind}}"
                                              Text="{l:TrKey {Binding Status}, Prefix=OrderStatus.}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="orders:OrderListItemDto">
                                    <StackPanel Orientation="Horizontal" Margin="8,0" Spacing="{StaticResource Space1}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <ui:IconButton Classes="ghost sm"
                                                       Icon="{StaticResource IconEye}"
                                                       ToolTip.Tip="{l:Tr Common.View}"
                                                       Command="{Binding $parent[DataGrid].((vm:OrdersViewModel)DataContext).ViewCommand}"
                                                       CommandParameter="{Binding}" />
                                        <ui:IconButton Classes="ghost sm"
                                                       Icon="{StaticResource IconPrinter}"
                                                       ToolTip.Tip="{l:Tr OrderDetails.PrintInvoice}"
                                                       Command="{Binding $parent[DataGrid].((vm:OrdersViewModel)DataContext).PrintInvoiceCommand}"
                                                       CommandParameter="{Binding}" />
                                        <ui:IconButton Classes="ghost sm"
                                                       Icon="{StaticResource IconDownload}"
                                                       ToolTip.Tip="{l:Tr OrderDetails.ExportInvoice}"
                                                       Command="{Binding $parent[DataGrid].((vm:OrdersViewModel)DataContext).ExportInvoiceCommand}"
                                                       CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ui:DataTable.Footer>
                    <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="{Binding PageCount}" IsEnabled="{Binding !IsLoading}" />
                </ui:DataTable.Footer>
            </ui:DataTable>
        </StackPanel>
    </ScrollViewer>
</UserControl>
