<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:patients="using:Mostawsef.Contracts.Patients"
             xmlns:common="using:Mostawsef.Contracts.Common"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.PatientsView"
             x:DataType="vm:PatientsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Nav.Patients}" Subtitle="{l:Tr Patients.Subtitle}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                        <Button Classes="secondary" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="{l:Tr Common.Refresh}" />
                            </StackPanel>
                        </Button>
                        <Button Name="ExportButton" Classes="secondary" Command="{Binding ExportCommand}" ToolTip.Tip="{l:Tr Patients.ExportHint}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:Tr Common.Export}" />
                            </StackPanel>
                        </Button>
                        <Button Name="AddPatientButton" Classes="primary" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{l:Tr Patients.Add}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:DataTable Height="560"
                          IsLoading="{Binding IsLoading}"
                          IsEmpty="{Binding IsEmpty}"
                          HasError="{Binding HasLoadError}"
                          ErrorTitle="{l:TrKey {Binding LoadErrorTitleKey}}"
                          ErrorDescription="{l:TrKey {Binding LoadErrorDescriptionKey}}"
                          RetryCommand="{Binding RefreshCommand}"
                          FirstRowNumber="{Binding FirstRowNumber}">
                <ui:DataTable.Toolbar>
                    <!-- Equal side columns keep the search box centered in the row. -->
                    <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="{StaticResource GapControls}">
                        <ui:SearchBox Name="SearchBox"
                                      Grid.Column="1"
                                      Text="{Binding Search}"
                                      MaxLength="{x:Static common:PageQuery.MaxSearchLength}"
                                      PlaceholderText="{l:Tr Patients.SearchPlaceholder}"
                                      SearchCommand="{Binding SearchCommand}" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{StaticResource GapControls}">
                            <TextBlock Classes="caption muted" Text="{l:Tr Patients.Records, Arg={Binding DisplayTotal}}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                <ui:IconButton Name="TableViewButton"
                                               Classes="ghost sm"
                                               Classes.selected="{Binding !IsGridView}"
                                               Icon="{StaticResource IconList}"
                                               ToolTip.Tip="{l:Tr Common.TableView}"
                                               Command="{Binding ShowTableCommand}" />
                                <ui:IconButton Name="GridViewButton"
                                               Classes="ghost sm"
                                               Classes.selected="{Binding IsGridView}"
                                               Icon="{StaticResource IconGrid}"
                                               ToolTip.Tip="{l:Tr Common.GridView}"
                                               Command="{Binding ShowGridCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:DataTable.Toolbar>

                <Panel>
                    <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="False" IsVisible="{Binding !IsGridView}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Patients.Col.FullName}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <Grid Margin="12,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ui:Avatar DisplayName="{Binding FullName}" MaxInitials="1" IsColorful="True"
                                                       Size="{StaticResource AvatarSizeSm}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" />
                                            <ui:CopyButton Grid.Column="2" Classes="sm" Text="{Binding FullName}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Patients.Col.Phone}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <Grid Margin="12,0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FlowDirection="LeftToRight"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Phone}" />
                                            <ui:CopyButton Grid.Column="1" Classes="sm" Text="{Binding Phone}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Patients.Col.GuardianPhone}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <TextBlock Margin="12,0" VerticalAlignment="Center" Classes="muted" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding GuardianPhone}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Patients.Col.Gender}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{l:TrKey {Binding Gender}, Prefix=Gender.}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="patients:PatientDto" Header="{l:Tr Patients.Col.DateOfBirth}" Width="120"
                                               Binding="{Binding DateOfBirth, Converter={x:Static conv:ValueConverters.ShortDate}}"
                                               IsReadOnly="True" />
                            <DataGridTemplateColumn Header="{l:Tr Patients.Col.Insured}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <Panel Margin="12,0" VerticalAlignment="Center">
                                            <ui:Badge Kind="Info" Text="{l:Tr Patients.Insured}" IsVisible="{Binding IsInsured}" />
                                            <ui:Badge Text="{l:Tr Patients.NotInsured}" IsVisible="{Binding !IsInsured}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="patients:PatientDto">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="8,0" VerticalAlignment="Center">
                                            <ui:IconButton Classes="ghost sm"
                                                           Icon="{StaticResource IconEdit}"
                                                           ToolTip.Tip="{l:Tr Common.Edit}"
                                                           Command="{Binding $parent[DataGrid].((vm:PatientsViewModel)DataContext).EditCommand}"
                                                           CommandParameter="{Binding}" />
                                            <ui:IconButton Classes="ghost destructive sm"
                                                           Icon="{StaticResource IconDelete}"
                                                           ToolTip.Tip="{l:Tr Common.Delete}"
                                                           Command="{Binding $parent[DataGrid].((vm:PatientsViewModel)DataContext).DeleteCommand}"
                                                           CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ItemsControl Name="CardsGrid"
                                  Margin="{StaticResource PaddingCardCompact}"
                                  IsVisible="{Binding IsGridView}"
                                  ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="patients:PatientDto">
                                <ui:Card Classes="outlined"
                                         Width="220"
                                         Height="220"
                                         Margin="0,0,12,12"
                                         Title="{Binding FullName}">
                                    <ui:Card.HeaderActions>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" VerticalAlignment="Top">
                                            <ui:IconButton Classes="ghost sm"
                                                           Icon="{StaticResource IconEdit}"
                                                           ToolTip.Tip="{l:Tr Common.Edit}"
                                                           Command="{Binding $parent[ItemsControl].((vm:PatientsViewModel)DataContext).EditCommand}"
                                                           CommandParameter="{Binding}" />
                                            <ui:IconButton Classes="ghost destructive sm"
                                                           Icon="{StaticResource IconDelete}"
                                                           ToolTip.Tip="{l:Tr Common.Delete}"
                                                           Command="{Binding $parent[ItemsControl].((vm:PatientsViewModel)DataContext).DeleteCommand}"
                                                           CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </ui:Card.HeaderActions>
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="{StaticResource Space1}" LineSpacing="{StaticResource Space1}">
                                            <ui:Badge Text="{l:TrKey {Binding Gender}, Prefix=Gender.}" />
                                            <ui:Badge Kind="Info" Text="{l:Tr Patients.Insured}" IsVisible="{Binding IsInsured}" />
                                        </WrapPanel>
                                        <StackPanel Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                                                <PathIcon Foreground="{DynamicResource BrushTextMuted}" Data="{StaticResource IconPhone}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" />
                                                <TextBlock Text="{Binding Phone}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Classes="caption muted"
                                                       Text="{Binding DateOfBirth, Converter={x:Static conv:ValueConverters.ShortDate}}"
                                                       IsVisible="{Binding DateOfBirth, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>

                <ui:DataTable.Footer>
                    <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="{Binding PageCount}" IsEnabled="{Binding !IsLoading}" />
                </ui:DataTable.Footer>
            </ui:DataTable>
        </StackPanel>
    </ScrollViewer>
</UserControl>
