<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:conv="using:Mostawsef.Desktop.Converters"
             xmlns:orders="using:Mostawsef.Contracts.Orders"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Admin"
             x:Class="Mostawsef.Desktop.Views.Admin.OrderDetailsView"
             x:DataType="vm:OrderDetailsViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr OrderDetails.Title, Arg={Binding Order.Number}}" Subtitle="{l:Tr OrderDetails.Subtitle}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                    <Button Name="PrintInvoiceButton" Classes="secondary" Command="{Binding PrintInvoiceCommand}"
                            IsVisible="{Binding HasOrder}" IsEnabled="{Binding CanUseInvoice}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconPrinter}" IsVisible="{Binding CanUseInvoice}" />
                            <ui:Spinner Width="16" Height="16" IsVisible="{Binding IsInvoiceBusy}" />
                            <TextBlock Text="{l:Tr OrderDetails.PrintInvoice}" />
                        </StackPanel>
                    </Button>
                    <Button Name="ExportInvoiceButton" Classes="secondary" Command="{Binding ExportInvoiceCommand}"
                            IsVisible="{Binding HasOrder}" IsEnabled="{Binding CanUseInvoice}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                            <PathIcon Data="{StaticResource IconDownload}" IsVisible="{Binding CanUseInvoice}" />
                            <ui:Spinner Width="16" Height="16" IsVisible="{Binding IsInvoiceBusy}" />
                            <TextBlock Text="{l:Tr OrderDetails.ExportInvoice}" />
                        </StackPanel>
                    </Button>
                    <ui:Badge Name="RefundBadge"
                              IsVisible="{Binding NeedsRefund}"
                              Kind="Info"
                              Text="{Binding RefundText}" />
                    <ui:Badge Name="StatusBadge"
                              IsVisible="{Binding HasOrder}"
                              Kind="{Binding Order.Status, Converter={x:Static conv:ValueConverters.OrderStatusToBadgeKind}, FallbackValue={x:Static ui:BadgeKind.Neutral}}"
                              Text="{l:TrKey {Binding Order.Status}, Prefix=OrderStatus.}" />
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <Panel MinHeight="240">
                <ui:ErrorState IsVisible="{Binding HasLoadError}"
                               Title="{l:TrKey {Binding LoadErrorTitleKey}}"
                               Description="{l:TrKey {Binding LoadErrorDescriptionKey}}"
                               RetryCommand="{Binding RefreshCommand}" />

                <Grid ColumnDefinitions="320,*" ColumnSpacing="{StaticResource GapGrid}" IsVisible="{Binding HasOrder}">
                    <!-- Sidebar: the order's main info and amounts. -->
                    <StackPanel Name="OrderSidebar" Spacing="{StaticResource GapGrid}">
                        <ui:StatCard Name="TotalCard" Title="{l:Tr Orders.Col.Total}" Value="{l:Money {Binding Order.Total}}" />
                        <ui:StatCard Name="PaidCard" Kind="Success" Title="{l:Tr Orders.Col.Paid}" Value="{l:Money {Binding Order.Paid}}" />
                        <ui:StatCard Name="BalanceCard" Kind="Warning" Icon="{StaticResource IconClock}"
                                     Title="{l:Tr OrderDetails.Balance}" Value="{l:Money {Binding Order.Balance}}" />

                        <ui:Card Title="{l:Tr OrderDetails.Info}">
                            <StackPanel Spacing="{StaticResource GapControls}">
                                <ui:DetailsView>
                                    <ui:DetailsItem Label="{l:Tr Orders.Col.Number}" Value="{Binding Order.Number, FallbackValue=''}" />
                                    <ui:DetailsItem Label="{l:Tr Orders.Col.Date}"
                                                    Value="{Binding Order.CreatedAt, Converter={x:Static conv:ValueConverters.LocalDateTime}, FallbackValue=''}" />
                                    <ui:DetailsItem Label="{l:Tr Orders.Col.Patient}" Value="{Binding Order.PatientName, FallbackValue=''}" />
                                    <ui:DetailsItem Label="{l:Tr Orders.Col.Phone}" Value="{Binding Order.PatientPhone, FallbackValue=''}" />
                                    <ui:DetailsItem Label="{l:Tr Orders.Col.Status}" Value="{l:TrKey {Binding Order.Status}, Prefix=OrderStatus.}" />
                                    <ui:DetailsItem Label="{l:Tr OrderDetails.CreatedBy}" Value="{Binding Order.CreatedBy, FallbackValue=''}" />
                                </ui:DetailsView>
                                <StackPanel Name="AddonRow" Spacing="{StaticResource GapControls}" IsVisible="{Binding HasAddon}">
                                    <ui:Divider />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapControls}">
                                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr NewOrder.Addon}" />
                                        <TextBlock Name="AddonText" Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium"
                                                   Text="{l:Money {Binding Order.Addon}}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- Body: payments first, then the tests. -->
                    <StackPanel Grid.Column="1" Spacing="{StaticResource GapGrid}">
                        <ui:Card Name="PaymentsCard" Classes="outlined" Padding="0"
                                 Title="{l:Tr OrderDetails.Payments, Arg={Binding Order.Payments.Count}}">
                            <ui:Card.HeaderActions>
                                <Button Name="AddPaymentButton" Classes="primary sm" Command="{Binding AddPaymentCommand}"
                                        IsVisible="{Binding CanAddPayment}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                        <PathIcon Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="{l:Tr OrderDetails.AddPayment}" />
                                    </StackPanel>
                                </Button>
                            </ui:Card.HeaderActions>
                            <Panel>
                                <DataGrid Name="PaymentsGrid" Margin="0,12,0,0" ItemsSource="{Binding Order.Payments}" IsReadOnly="True"
                                          CanUserSortColumns="False" IsVisible="{Binding HasPayments}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:DataType="orders:OrderPaymentDto" Header="{l:Tr OrderDetails.Col.PaidAt}" Width="170"
                                                            Binding="{Binding PaidAt, Converter={x:Static conv:ValueConverters.LocalDateTime}}" />
                                        <DataGridTemplateColumn Header="{l:Tr OrderDetails.Col.Type}" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="orders:OrderPaymentDto">
                                                    <TextBlock Margin="12,0" VerticalAlignment="Center"
                                                               Text="{l:TrKey {Binding Type}, Prefix=PaymentType.}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{l:Tr NewOrder.PaymentMethod}" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="orders:OrderPaymentDto">
                                                    <TextBlock Margin="12,0" VerticalAlignment="Center"
                                                               Text="{l:TrKey {Binding Method}, Prefix=PaymentMethod.}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn x:DataType="orders:OrderPaymentDto" Header="{l:Tr NewOrder.PaymentAmount}" Width="140"
                                                            Binding="{Binding Amount, Converter={x:Static conv:ValueConverters.Money}}" />
                                        <DataGridTextColumn x:DataType="orders:OrderPaymentDto" Header="{l:Tr NewOrder.PaymentNotes}" Width="*"
                                                            Binding="{Binding Notes}" />
                                        <DataGridTemplateColumn Header="{l:Tr Common.Actions}" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="orders:OrderPaymentDto">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="8,0" VerticalAlignment="Center">
                                                        <ui:IconButton Classes="ghost sm"
                                                                       Icon="{StaticResource IconEdit}"
                                                                       ToolTip.Tip="{l:Tr Common.Edit}"
                                                                       Command="{Binding $parent[DataGrid].((vm:OrderDetailsViewModel)DataContext).EditPaymentCommand}"
                                                                       CommandParameter="{Binding}" />
                                                        <ui:IconButton Classes="ghost destructive sm"
                                                                       Icon="{StaticResource IconDelete}"
                                                                       ToolTip.Tip="{l:Tr Common.Delete}"
                                                                       Command="{Binding $parent[DataGrid].((vm:OrderDetailsViewModel)DataContext).DeletePaymentCommand}"
                                                                       CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Name="PaymentsEmpty" Classes="muted" Margin="20,16" IsVisible="{Binding !HasPayments}"
                                           Text="{l:Tr OrderDetails.NoPayments}" />
                            </Panel>
                        </ui:Card>

                        <ui:Card Name="TestsCard" Classes="outlined" Padding="0"
                                 Title="{l:Tr OrderDetails.Tests, Arg={Binding Order.Items.Count}}">
                            <DataGrid Name="TestsGrid" Margin="0,12,0,0" ItemsSource="{Binding Order.Items}" IsReadOnly="True" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:DataType="orders:OrderItemDto" Header="{l:Tr LabTests.Col.Code}" Width="140"
                                                        Binding="{Binding Code}" />
                                    <DataGridTextColumn x:DataType="orders:OrderItemDto" Header="{l:Tr LabTests.Col.Name}" Width="*"
                                                        Binding="{Binding Name}" />
                                    <DataGridTextColumn x:DataType="orders:OrderItemDto" Header="{l:Tr LabTests.Col.LabCost}" Width="140"
                                                        Binding="{Binding LabCost, Converter={x:Static conv:ValueConverters.Money}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>
                    </StackPanel>
                </Grid>

                <ui:LoadingOverlay IsLoading="{Binding IsLoading}" />
            </Panel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
