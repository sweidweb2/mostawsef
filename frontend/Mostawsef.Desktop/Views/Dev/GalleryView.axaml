<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Dev"
             xmlns:sections="using:Mostawsef.Desktop.Views.Dev.Sections"
             x:Class="Mostawsef.Desktop.Views.Dev.GalleryView"
             x:DataType="vm:GalleryViewModel">

    <ui:AppShell Name="Shell">
        <ui:AppShell.SidebarHeader>
            <ui:BrandMark />
        </ui:AppShell.SidebarHeader>

        <ui:AppShell.Sidebar>
            <ui:NavMenu SelectedIndex="{Binding SelectedSectionIndex}"
                        IsCompact="{Binding #Shell.IsSidebarCompact}">
                <ui:NavMenuItem Icon="{StaticResource IconDashboard}" Text="{l:Tr Gallery.Layout}" />
                <ui:NavMenuItem Icon="{StaticResource IconEdit}" Text="{l:Tr Gallery.Forms}" />
                <ui:NavMenuItem Icon="{StaticResource IconDocument}" Text="{l:Tr Gallery.Data}" />
                <ui:NavMenuItem Icon="{StaticResource IconBell}" Text="{l:Tr Gallery.Feedback}" />
            </ui:NavMenu>
        </ui:AppShell.Sidebar>

        <ui:AppShell.TopBar>
            <ui:TopBar Title="{l:Tr Gallery.Title}">
                <ui:TopBar.Leading>
                    <ui:IconButton Classes="ghost"
                                   Icon="{StaticResource IconChevronStart}"
                                   Command="{Binding BackCommand}"
                                   ToolTip.Tip="{l:Tr Common.Back}" />
                </ui:TopBar.Leading>
                <ui:SearchBox MaxWidth="360" HorizontalAlignment="Left" Classes="hide-compact" />
                <ui:TopBar.Actions>
                    <ui:PreferencesBar />
                </ui:TopBar.Actions>
            </ui:TopBar>
        </ui:AppShell.TopBar>

        <Carousel SelectedIndex="{Binding SelectedSectionIndex}">
            <sections:LayoutSection />
            <sections:FormsSection />
            <sections:DataSection />
            <sections:FeedbackSection />
        </Carousel>
    </ui:AppShell>
</UserControl>
