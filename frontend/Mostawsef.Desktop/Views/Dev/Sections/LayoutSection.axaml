<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Dev"
             x:Class="Mostawsef.Desktop.Views.Dev.Sections.LayoutSection"
             x:DataType="vm:GalleryViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Gallery.Layout}" Subtitle="{l:Tr Gallery.Subtitle}">
                <ui:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="{l:Tr Common.Export}" />
                        <Button Classes="primary">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{l:Tr Common.Add}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:Section Title="Card" Description="Default, outlined, flat and interactive.">
                <ui:ResponsiveGrid MinColumnWidth="220">
                    <ui:Card Title="Default" Subtitle="Elevated surface">
                        <TextBlock Text="Card content." TextWrapping="Wrap" />
                    </ui:Card>
                    <ui:Card Classes="outlined" Title="Outlined">
                        <TextBlock Text="No shadow." />
                        <ui:Card.Footer>
                            <Button Classes="link" Content="{l:Tr Common.View}" />
                        </ui:Card.Footer>
                    </ui:Card>
                    <ui:Card Classes="flat" Title="Flat">
                        <TextBlock Text="Subtle background." />
                    </ui:Card>
                    <ui:Card Classes="interactive" Title="Interactive">
                        <ui:Card.HeaderActions>
                            <ui:IconButton Classes="ghost sm" Icon="{StaticResource IconMore}" />
                        </ui:Card.HeaderActions>
                        <TextBlock Text="Hover me." />
                    </ui:Card>
                </ui:ResponsiveGrid>
            </ui:Section>

            <ui:Section Title="Tabs + Divider">
                <ui:Card>
                    <StackPanel>
                        <TabControl>
                            <TabItem Header="Overview">
                                <TextBlock Margin="0,12" Text="Overview tab" />
                            </TabItem>
                            <TabItem Header="History">
                                <TextBlock Margin="0,12" Text="History tab" />
                            </TabItem>
                            <TabItem Header="Billing">
                                <TextBlock Margin="0,12" Text="Billing tab" />
                            </TabItem>
                        </TabControl>
                        <ui:Divider Text="OR" />
                        <ui:Divider />
                    </StackPanel>
                </ui:Card>
            </ui:Section>
        </StackPanel>
    </ScrollViewer>
</UserControl>
