<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Dev"
             x:Class="Mostawsef.Desktop.Views.Dev.Sections.DataSection"
             x:DataType="vm:GalleryViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Gallery.Data}" />

            <ui:Section Title="DataTable + Pagination">
                <ui:Section.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary sm" Content="Toggle loading" Command="{Binding ToggleTableLoadingCommand}" />
                        <Button Classes="secondary sm" Content="Toggle empty" Command="{Binding ToggleTableEmptyCommand}" />
                        <Button Classes="secondary sm" Content="Toggle error" Command="{Binding ToggleTableErrorCommand}" />
                    </StackPanel>
                </ui:Section.Actions>
                <ui:DataTable Height="380"
                              IsLoading="{Binding IsTableLoading}"
                              IsEmpty="{Binding IsTableEmpty}"
                              HasError="{Binding IsTableError}"
                              RetryCommand="{Binding ToggleTableErrorCommand}">
                    <ui:DataTable.Toolbar>
                        <Grid ColumnDefinitions="*,Auto">
                            <ui:SearchBox MaxWidth="320" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Classes="primary">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:Tr Common.Add}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </ui:DataTable.Toolbar>
                    <DataGrid ItemsSource="{Binding VisiblePatients}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Common.RowNumber}" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:RowNumber Margin="12,0" VerticalAlignment="Center" Classes="muted" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="vm:PatientRow" Header="{l:Tr Patient.FileNo}" Binding="{Binding FileNumber}" Width="120" />
                            <DataGridTemplateColumn Header="Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PatientRow">
                                        <Grid Margin="12,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ui:Avatar DisplayName="{Binding Name}" MaxInitials="1" IsColorful="True" Size="{DynamicResource AvatarSizeSm}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            <ui:CopyButton Grid.Column="2" Classes="sm" Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="vm:PatientRow" Header="{l:Tr Patient.Age}" Binding="{Binding Age}" Width="80" />
                            <DataGridTextColumn x:DataType="vm:PatientRow" Header="{l:Tr Patient.Phone}" Binding="{Binding Phone}" Width="150" />
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PatientRow">
                                        <ui:Badge Margin="12,0" Text="{Binding Status}" Kind="{Binding StatusKind}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:DataTable.Footer>
                        <ui:Pagination CurrentPage="{Binding CurrentPage}" PageCount="12" />
                    </ui:DataTable.Footer>
                </ui:DataTable>
            </ui:Section>

            <ui:Section Title="StatCard">
                <ui:ResponsiveGrid MinColumnWidth="220">
                    <ui:StatCard Title="Patients" Value="1,284" Caption="+12 this week" Icon="{StaticResource IconUsers}" Kind="Primary" />
                    <ui:StatCard Title="Appointments today" Value="36" Icon="{StaticResource IconCalendar}" Kind="Info" />
                    <ui:StatCard Title="Paid invoices" Value="92%" Icon="{StaticResource IconSuccess}" Kind="Success" />
                    <ui:StatCard Title="Critical errors" Value="2" Icon="{StaticResource IconWarning}" Kind="Danger" />
                </ui:ResponsiveGrid>
            </ui:Section>

            <ui:Section Title="DetailsView">
                <ui:Card>
                    <ui:DetailsView>
                        <ui:DetailsItem Label="File No." Value="P-1001" />
                        <ui:DetailsItem Label="Name" Value="أحمد علي" />
                        <ui:DetailsItem Label="Notes" Value="" />
                        <ui:DetailsItem Label="Details" Value="{}{ &quot;allergies&quot;: [&quot;Penicillin&quot;] }" IsCode="True" />
                    </ui:DetailsView>
                </ui:Card>
            </ui:Section>

            <ui:Section Title="Badge + Avatar">
                <ui:Card>
                    <StackPanel Spacing="16">
                        <WrapPanel>
                            <ui:Badge Margin="0,0,8,8" Text="Neutral" />
                            <ui:Badge Margin="0,0,8,8" Text="Primary" Kind="Primary" />
                            <ui:Badge Margin="0,0,8,8" Text="Success" Kind="Success" />
                            <ui:Badge Margin="0,0,8,8" Text="Warning" Kind="Warning" />
                            <ui:Badge Margin="0,0,8,8" Text="Danger" Kind="Danger" />
                            <ui:Badge Margin="0,0,8,8" Text="Info" Kind="Info" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ui:Avatar DisplayName="Sara Mahmoud" Size="32" />
                            <ui:Avatar DisplayName="أحمد علي" />
                            <ui:Avatar DisplayName="Omar Khaled" Size="56" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ui:Avatar DisplayName="Rabi3 kasir" MaxInitials="1" IsColorful="True" Size="32" />
                            <ui:Avatar DisplayName="Jawad ezzeddine" MaxInitials="1" IsColorful="True" Size="32" />
                            <ui:Avatar DisplayName="zein baydon" MaxInitials="1" IsColorful="True" Size="32" />
                            <ui:Avatar DisplayName="منى عادل" MaxInitials="1" IsColorful="True" Size="32" />
                            <ui:Avatar DisplayName="hasan rahhal" MaxInitials="1" IsColorful="True" Size="32" />
                            <ui:CopyButton Text="Copied from the gallery" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </ui:Section>
        </StackPanel>
    </ScrollViewer>
</UserControl>
