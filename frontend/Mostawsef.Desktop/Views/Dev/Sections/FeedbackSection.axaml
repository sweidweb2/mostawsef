<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Dev"
             x:Class="Mostawsef.Desktop.Views.Dev.Sections.FeedbackSection"
             x:DataType="vm:GalleryViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <ui:PageHeader Title="{l:Tr Gallery.Feedback}" />

            <ui:Section Title="Toast">
                <WrapPanel>
                    <Button Classes="secondary" Margin="0,0,8,8" Content="Info" Command="{Binding ShowToastCommand}" CommandParameter="Info" />
                    <Button Classes="secondary" Margin="0,0,8,8" Content="Success" Command="{Binding ShowToastCommand}" CommandParameter="Success" />
                    <Button Classes="secondary" Margin="0,0,8,8" Content="Warning" Command="{Binding ShowToastCommand}" CommandParameter="Warning" />
                    <Button Classes="secondary" Margin="0,0,8,8" Content="Error" Command="{Binding ShowToastCommand}" CommandParameter="Error" />
                </WrapPanel>
            </ui:Section>

            <ui:Section Title="Modal / ConfirmDialog">
                <WrapPanel>
                    <Button Classes="primary" Margin="0,0,8,8" Content="Open modal" Command="{Binding ShowModalCommand}" />
                    <Button Classes="danger" Margin="0,0,8,8" Content="{l:Tr Common.Delete}" Command="{Binding ShowConfirmCommand}" />
                </WrapPanel>
            </ui:Section>

            <ui:Section Title="Spinner + LoadingOverlay">
                <ui:Section.Actions>
                    <Button Classes="secondary sm" Content="Toggle overlay" Command="{Binding ToggleOverlayCommand}" />
                </ui:Section.Actions>
                <ui:ResponsiveGrid MinColumnWidth="260">
                    <ui:Card>
                        <ui:Spinner HorizontalAlignment="Center" Margin="0,24" />
                    </ui:Card>
                    <ui:Card Padding="0">
                        <ui:LoadingOverlay IsLoading="{Binding IsOverlayLoading}"
                                           Message="{l:Tr Common.Loading}"
                                           CornerRadius="{DynamicResource RadiusLg}">
                            <StackPanel Margin="20" Spacing="8">
                                <TextBlock Classes="h4" Text="Content" />
                                <TextBlock Classes="muted" Text="Covered while loading." />
                                <ProgressBar Value="65" />
                            </StackPanel>
                        </ui:LoadingOverlay>
                    </ui:Card>
                </ui:ResponsiveGrid>
            </ui:Section>

            <ui:Section Title="ProgressBar">
                <ui:Card>
                    <StackPanel Spacing="12">
                        <ProgressBar Value="40" />
                        <ProgressBar Classes="success" Value="80" />
                        <ProgressBar Classes="warning" Value="55" />
                        <ProgressBar Classes="danger" Value="20" />
                        <ProgressBar IsIndeterminate="True" />
                    </StackPanel>
                </ui:Card>
            </ui:Section>

            <ui:Section Title="EmptyState">
                <ui:Card>
                    <ui:EmptyState Margin="0,24">
                        <ui:EmptyState.Action>
                            <Button Classes="primary" Content="{l:Tr Common.Add}" />
                        </ui:EmptyState.Action>
                    </ui:EmptyState>
                </ui:Card>
            </ui:Section>

            <ui:Section Title="ErrorState">
                <ui:Card>
                    <ui:ErrorState Margin="0,24" RetryCommand="{Binding ShowToastCommand}" />
                </ui:Card>
            </ui:Section>
        </StackPanel>
    </ScrollViewer>
</UserControl>
