<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:diag="using:Mostawsef.Desktop.Services.Diagnostics"
             x:Class="Mostawsef.Desktop.Views.Dev.PerfOverlay"
             x:DataType="diag:PerformanceMonitor">

    <Border IsVisible="{Binding IsOverlayVisible}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="16"
            Padding="{DynamicResource PaddingCardCompact}"
            Width="420"
            MaxHeight="320"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLg}"
            BoxShadow="{DynamicResource ShadowLg}">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="strong" Text="{l:Tr Perf.Title}" />
                    <TextBlock Classes="caption muted" Text="{l:Tr Perf.ToggleHint}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost sm"
                        Content="{l:Tr Perf.Clear}"
                        Command="{Binding ClearCommand}"
                        Margin="4,0,0,0" />
                <ui:IconButton Grid.Column="2"
                               Classes="ghost sm"
                               Icon="{StaticResource IconDocument}"
                               ToolTip.Tip="{l:Tr Perf.OpenLog}"
                               Command="{Binding OpenLogFolderCommand}" />
                <ui:IconButton Grid.Column="3"
                               Classes="ghost sm"
                               Icon="{StaticResource IconClose}"
                               Command="{Binding ToggleOverlayCommand}" />
            </Grid>

            <TextBlock DockPanel.Dock="Top"
                       Classes="caption muted"
                       Text="{l:Tr Perf.Empty}"
                       IsVisible="{Binding !HasEntries}"
                       Margin="0,8" />

            <ItemsControl Classes="virtualizing" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="diag:PerfEntry">
                        <TextBlock Classes="caption"
                                   Classes.danger="{Binding IsSlow}"
                                   Classes.warning="{Binding IsWarn}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   Text="{Binding Line}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1"
                                   ToolTip.Tip="{Binding Line}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
