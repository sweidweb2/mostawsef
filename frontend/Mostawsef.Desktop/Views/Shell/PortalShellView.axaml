<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Mostawsef.Desktop.Components"
             xmlns:l="using:Mostawsef.Desktop.Services.Local"
             xmlns:vm="using:Mostawsef.Desktop.ViewModels.Shell"
             xmlns:nav="using:Mostawsef.Desktop.Services.Navigation"
             x:Class="Mostawsef.Desktop.Views.Shell.PortalShellView"
             x:DataType="vm:PortalShellViewModel">

    <!-- Shared layout of every role portal (Admin, Super, ...). -->
    <ui:AppShell Name="Shell">
        <ui:AppShell.SidebarHeader>
            <ui:BrandMark />
        </ui:AppShell.SidebarHeader>

        <ui:AppShell.Sidebar>
            <ui:NavMenu ItemsSource="{Binding MenuItems}"
                        SelectedIndex="{Binding SelectedMenuIndex}"
                        IsCompact="{Binding #Shell.IsSidebarCompact}">
                <ui:NavMenu.Styles>
                    <Style Selector="ui|NavMenuItem" x:DataType="nav:PortalPage">
                        <Setter Property="Text" Value="{l:TrKey {Binding TitleKey}}" />
                        <Setter Property="Icon" Value="{Binding Icon}" />
                    </Style>
                </ui:NavMenu.Styles>
            </ui:NavMenu>
        </ui:AppShell.Sidebar>

        <ui:AppShell.SidebarFooter>
            <ui:NavMenuItem Icon="{StaticResource IconLogout}"
                            Text="{l:TrKey {Binding LeaveKey}}"
                            IsCompact="{Binding #Shell.IsSidebarCompact}"
                            Command="{Binding SignOutCommand}" />
        </ui:AppShell.SidebarFooter>

        <ui:AppShell.TopBar>
            <ui:TopBar>
                <ui:TopBar.Leading>
                    <StackPanel Name="Breadcrumb" Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="0,0,16,0">
                        <TextBlock Name="BreadcrumbCurrent" Classes="h4" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasSubPage}"
                                   Text="{l:TrKey {Binding MenuTitleKey}}" />
                        <Button Name="BreadcrumbRoot" Classes="ghost" IsVisible="{Binding HasSubPage}"
                                Command="{Binding BackCommand}">
                            <TextBlock Classes="h4" Text="{l:TrKey {Binding MenuTitleKey}}" />
                        </Button>
                        <PathIcon Name="BreadcrumbSeparator" IsVisible="{Binding HasSubPage}"
                                  Data="{StaticResource IconChevronEnd}" Opacity="0.6" />
                        <TextBlock Name="BreadcrumbSubPage" Classes="h4" VerticalAlignment="Center"
                                   IsVisible="{Binding HasSubPage}"
                                   Text="{l:TrKey {Binding SubPageTitleKey}, Arg={Binding SubPageTitleArg}}" />
                    </StackPanel>
                </ui:TopBar.Leading>
                <ui:TopBar.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                        <ui:PreferencesBar />
                        <ui:Divider Orientation="Vertical" Height="24" />
                        <Button Name="UserMenuButton" Classes="ghost">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Name="ChangePasswordMenuItem"
                                              Header="{l:Tr Auth.ChangePassword}"
                                              Command="{Binding ChangePasswordCommand}"
                                              IsVisible="{Binding CanManageAccount}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource IconKey}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="LogoutMenuItem" Header="{l:TrKey {Binding LeaveKey}}" Command="{Binding SignOutCommand}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource IconLogout}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControls}">
                                <ui:Avatar DisplayName="{Binding DisplayName}" Size="{StaticResource AvatarSizeSm}" />
                                <StackPanel VerticalAlignment="Center" Classes="hide-compact">
                                    <TextBlock Classes="strong" Text="{Binding DisplayName}" />
                                    <TextBlock Classes="caption muted" Text="{l:TrKey {Binding RoleKey}}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:TopBar.Actions>
            </ui:TopBar>
        </ui:AppShell.TopBar>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top"
                        Margin="{StaticResource PaddingPageCompact}"
                        Spacing="{StaticResource Space2}">
                <ui:Alert Name="ConnectionBanner"
                          Kind="{Binding Connection.AlertKind}"
                          Text="{l:TrKey {Binding Connection.MessageKey}}" />
                <Grid Name="UpdateBanner"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource GapControls}"
                      IsVisible="{Binding Updates.IsAvailable}">
                    <ui:Alert Name="UpdateAvailableAlert"
                              Kind="Info"
                              Text="{Binding Updates.BannerText}" />
                    <Button Name="DownloadUpdateButton"
                            Grid.Column="1"
                            Classes="secondary sm"
                            VerticalAlignment="Center"
                            Command="{Binding Updates.DownloadCommand}">
                        <TextBlock Text="{l:Tr Update.Download}" />
                    </Button>
                </Grid>
            </StackPanel>
            <ui:PageHost Name="PageHost" Page="{Binding CurrentPage}" />
        </DockPanel>
    </ui:AppShell>
</UserControl>
