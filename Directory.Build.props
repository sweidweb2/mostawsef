<Project>
  <!-- Settings shared by every project. A project overrides one by setting it again in its .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Product semver (Setup + Desktop + API). Override on publish: -p:Version=1.2.0 (build-setup.ps1). -->
    <Version>1.0.0</Version>
    <!-- A newly published vulnerability in a package must not suddenly break the build: it stays a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
